<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    HUD tokens. This is the only file with hex values.
    Root-level dictionary (not ThemeDictionaries): the HUD is dark-only and app brushes
    in theme dictionaries can fail to resolve on Uno.
  -->
  <Color x:Key="HudInkColor">#EDEDED</Color>
  <Color x:Key="HudDimColor">#5E5E5E</Color>
  <Color x:Key="HudTrackColor">#3A3A3A</Color>
  <Color x:Key="HudGroundColor">#000000</Color>
  <Color x:Key="HudMutedColor">#8F8F8F</Color>

  <!-- Optional accents from the HUD Ring Components canvas. -->
  <Color x:Key="HudCyanColor">#7FD4FF</Color>
  <Color x:Key="HudAmberColor">#FFB547</Color>
  <Color x:Key="HudVioletColor">#B9A7FF</Color>

  <SolidColorBrush x:Key="HudInkBrush" Color="{StaticResource HudInkColor}" />
  <SolidColorBrush x:Key="HudDimBrush" Color="{StaticResource HudDimColor}" />
  <SolidColorBrush x:Key="HudTrackBrush" Color="{StaticResource HudTrackColor}" />
  <SolidColorBrush x:Key="HudGroundBrush" Color="{StaticResource HudGroundColor}" />
  <SolidColorBrush x:Key="HudMutedBrush" Color="{StaticResource HudMutedColor}" />
  <SolidColorBrush x:Key="HudCyanBrush" Color="{StaticResource HudCyanColor}" />
  <SolidColorBrush x:Key="HudAmberBrush" Color="{StaticResource HudAmberColor}" />
  <SolidColorBrush x:Key="HudVioletBrush" Color="{StaticResource HudVioletColor}" />

  <!--
    Static TTFs (variable fonts render only their default instance on Skia).
    The #fragment is the internal family name, which differs per file.
  -->
  <FontFamily x:Key="HudMonoFontFamily">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>
  <FontFamily x:Key="HudMonoMediumFontFamily">ms-appx:///Assets/Fonts/IBMPlexMono-Medium.ttf#IBM Plex Mono Medium</FontFamily>

  <!-- Type: Material scale for size, HUD family and colour only. Labels are authored uppercase. -->
  <Style x:Key="HudLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="FontFamily" Value="{StaticResource HudMonoFontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource HudMutedBrush}" />
  </Style>

  <Style x:Key="HudTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="FontFamily" Value="{StaticResource HudMonoMediumFontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource HudInkBrush}" />
  </Style>

  <Style x:Key="HudStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="FontFamily" Value="{StaticResource HudMonoMediumFontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource HudInkBrush}" />
  </Style>

  <!--
    Segment pill: 44 px tall, CornerRadius = half the height (larger radii render as ovals on Skia).
    CommonStates only touch the outline and the unchecked label; CheckStates only touch the checked
    plate and its label. No property is set by both groups, so hovering a checked pill can't
    repaint its text ink-on-ink.
  -->
  <Style x:Key="HudSegmentStyle" TargetType="RadioButton">
    <Setter Property="Height" Value="44" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontFamily" Value="{StaticResource HudMonoMediumFontFamily}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource HudInkBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="RootGrid" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Outline.BorderBrush" Value="{StaticResource HudMutedBrush}" />
                    <Setter Target="Label.Foreground" Value="{StaticResource HudInkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Outline.BorderBrush" Value="{StaticResource HudInkBrush}" />
                    <Setter Target="Label.Foreground" Value="{StaticResource HudInkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="CheckedPlate.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Outline"
                    CornerRadius="22"
                    BorderThickness="1"
                    BorderBrush="{StaticResource HudTrackBrush}" />
            <ContentPresenter x:Name="Label"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{StaticResource HudMutedBrush}" />
            <Border x:Name="CheckedPlate"
                    CornerRadius="22"
                    Background="{StaticResource HudInkBrush}"
                    Visibility="Collapsed">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{StaticResource HudGroundBrush}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
