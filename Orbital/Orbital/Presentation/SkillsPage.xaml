<Page x:Class="Orbital.Presentation.SkillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:Orbital.Controls"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource OrbitalSurface0Brush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Title="Skills"
                         Subtitle="Claude Code skill extensions and slash commands" />

    <ScrollViewer Grid.Row="1">
      <utu:AutoLayout Spacing="24"
                      Padding="{utu:Responsive Narrow='16', Normal='32', Wide='32'}"
                      MaxWidth="1200">

        <!-- Stat Cards -->
        <Grid x:Name="StatsRow" Opacity="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Installed -->
          <Border Grid.Column="0" Style="{StaticResource OrbitalCardStyle}">
            <utu:AutoLayout Spacing="4" Padding="4">
              <TextBlock Text="INSTALLED" Style="{StaticResource OrbitalSectionSubLabel}"
                         Foreground="{ThemeResource OrbitalText30Brush}" />
              <TextBlock x:Name="StatInstalled" Text="{Binding InstalledCount, FallbackValue='--'}"
                         Style="{StaticResource OrbitalCardValue}"
                         Foreground="{ThemeResource OrbitalText88Brush}" />
              <TextBlock Text="skill extensions" Style="{StaticResource OrbitalMonoMeta}"
                         Foreground="{ThemeResource OrbitalText35Brush}" />
            </utu:AutoLayout>
          </Border>

          <!-- Active -->
          <Border Grid.Column="2" Style="{StaticResource OrbitalCardStyle}">
            <utu:AutoLayout Spacing="4" Padding="4">
              <TextBlock Text="ACTIVE" Style="{StaticResource OrbitalSectionSubLabel}"
                         Foreground="{ThemeResource OrbitalText30Brush}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StatActive" Text="{Binding ActiveCount, FallbackValue='--'}"
                           Style="{StaticResource OrbitalCardValue}"
                           Foreground="{ThemeResource OrbitalEmerald400Brush}" />
                <controls:PulsingBars BarCount="3" BarColor="emerald" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="enabled" Style="{StaticResource OrbitalMonoMeta}"
                         Foreground="{ThemeResource OrbitalText35Brush}" />
            </utu:AutoLayout>
          </Border>

          <!-- Invocations 30D -->
          <Border Grid.Column="4" Style="{StaticResource OrbitalCardStyle}">
            <utu:AutoLayout Spacing="4" Padding="4">
              <TextBlock Text="INVOCATIONS" Style="{StaticResource OrbitalSectionSubLabel}"
                         Foreground="{ThemeResource OrbitalText30Brush}" />
              <TextBlock x:Name="StatInvocations" Text="{Binding InvocationCount, FallbackValue='--'}"
                         Style="{StaticResource OrbitalCardValue}"
                         Foreground="{ThemeResource OrbitalText88Brush}" />
              <TextBlock Text="last 30 days" Style="{StaticResource OrbitalMonoMeta}"
                         Foreground="{ThemeResource OrbitalText35Brush}" />
            </utu:AutoLayout>
          </Border>

          <!-- Avg Accuracy -->
          <Border Grid.Column="6" Style="{StaticResource OrbitalCardStyle}">
            <utu:AutoLayout Spacing="4" Padding="4">
              <TextBlock Text="AVG ACCURACY" Style="{StaticResource OrbitalSectionSubLabel}"
                         Foreground="{ThemeResource OrbitalText30Brush}" />
              <TextBlock x:Name="StatAccuracy" Text="{Binding AvgAccuracy, FallbackValue='--'}"
                         Style="{StaticResource OrbitalCardValue}"
                         Foreground="{ThemeResource OrbitalText88Brush}" />
              <TextBlock Text="trigger match" Style="{StaticResource OrbitalMonoMeta}"
                         Foreground="{ThemeResource OrbitalText35Brush}" />
            </utu:AutoLayout>
          </Border>
        </Grid>

        <!-- Skill groups, bound to SkillsModel.Groups (IListFeed<SkillGroup>) -->
        <muxc:ItemsRepeater x:Name="SkillGroupsRepeater"
                            ItemsSource="{Binding Groups}"
                            Opacity="0">
          <muxc:ItemsRepeater.Layout>
            <muxc:StackLayout Spacing="24" />
          </muxc:ItemsRepeater.Layout>
          <muxc:ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding CategoryDisplay}"
                           Style="{StaticResource OrbitalSectionSubLabel}"
                           Foreground="{ThemeResource OrbitalText30Brush}"
                           Margin="0,0,0,4" />
                <muxc:ItemsRepeater ItemsSource="{Binding Skills}">
                  <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout Orientation="Horizontal"
                                            MaximumRowsOrColumns="2"
                                            MinColumnSpacing="12"
                                            MinRowSpacing="8"
                                            ItemsStretch="Fill" />
                  </muxc:ItemsRepeater.Layout>
                  <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{ThemeResource OrbitalSurface1Brush}"
                              BorderBrush="{ThemeResource OrbitalSurface3Brush}"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="16,14"
                              Tag="{Binding Id}"
                              Loaded="OnSkillCardLoaded"
                              Tapped="OnSkillCardTapped">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource OrbitalMonoConsole}"
                                       Foreground="{ThemeResource OrbitalText75Brush}" />
                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource OrbitalMonoMeta}"
                                       Foreground="{ThemeResource OrbitalText35Brush}"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="4" Height="4"
                                         Fill="{ThemeResource OrbitalText25Brush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InvocationsText}"
                                           Style="{StaticResource OrbitalMonoMeta}"
                                           Foreground="{ThemeResource OrbitalText30Brush}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="4" Height="4"
                                         Fill="{ThemeResource OrbitalText25Brush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AccuracyText}"
                                           Style="{StaticResource OrbitalMonoMeta}"
                                           Foreground="{ThemeResource OrbitalText30Brush}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                          <!-- Toggle indicator: track + dot, positioned by OnSkillCardLoaded -->
                          <Border Grid.Column="2"
                                  x:Name="ToggleTrack"
                                  Width="40" Height="24"
                                  CornerRadius="12"
                                  VerticalAlignment="Top">
                            <Border x:Name="ToggleDot"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Margin="4" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
              </StackPanel>
            </DataTemplate>
          </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>
      </utu:AutoLayout>
    </ScrollViewer>
  </Grid>
</Page>
