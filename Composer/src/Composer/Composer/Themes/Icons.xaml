<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Reusable PathGeometry resources. Each one is a 14×14 viewport icon
      declared with explicit PathFigure / segment elements (the path
      mini-language string syntax does not parse into PathFigureCollection
      at XAML resource time, only inline on Path.Data).
    -->

    <!-- Chevron (10×10) — arrow pointing down -->
    <PathGeometry x:Key="IconChevronGeometry">
        <PathFigure StartPoint="2,3.5" IsClosed="False">
            <LineSegment Point="5,7" />
            <LineSegment Point="8,3.5" />
        </PathFigure>
    </PathGeometry>

    <!-- Status check (14×14) -->
    <PathGeometry x:Key="IconCheckGeometry">
        <PathFigure StartPoint="4,7.4" IsClosed="False">
            <LineSegment Point="6,9.2" />
            <LineSegment Point="10,5.2" />
        </PathFigure>
    </PathGeometry>

    <!-- Web — globe with horizontal+vertical meridians -->
    <PathGeometry x:Key="IconWebGeometry">
        <!-- Outer circle -->
        <PathFigure StartPoint="7,1" IsClosed="True">
            <ArcSegment Point="7,13" Size="6,6" SweepDirection="Clockwise" IsLargeArc="False" />
            <ArcSegment Point="7,1"  Size="6,6" SweepDirection="Clockwise" IsLargeArc="False" />
        </PathFigure>
        <!-- Equator -->
        <PathFigure StartPoint="1,7" IsClosed="False">
            <LineSegment Point="13,7" />
        </PathFigure>
        <!-- Left meridian -->
        <PathFigure StartPoint="7,1" IsClosed="False">
            <BezierSegment Point1="4.5,3" Point2="4.5,11" Point3="7,13" />
        </PathFigure>
        <!-- Right meridian -->
        <PathFigure StartPoint="7,1" IsClosed="False">
            <BezierSegment Point1="9.5,3" Point2="9.5,11" Point3="7,13" />
        </PathFigure>
    </PathGeometry>

    <!-- Windows — four squares -->
    <PathGeometry x:Key="IconWindowsGeometry">
        <PathFigure StartPoint="1.5,1.5" IsClosed="True">
            <LineSegment Point="6,1.5" />
            <LineSegment Point="6,6" />
            <LineSegment Point="1.5,6" />
        </PathFigure>
        <PathFigure StartPoint="8,1.5" IsClosed="True">
            <LineSegment Point="12.5,1.5" />
            <LineSegment Point="12.5,6" />
            <LineSegment Point="8,6" />
        </PathFigure>
        <PathFigure StartPoint="1.5,8" IsClosed="True">
            <LineSegment Point="6,8" />
            <LineSegment Point="6,12.5" />
            <LineSegment Point="1.5,12.5" />
        </PathFigure>
        <PathFigure StartPoint="8,8" IsClosed="True">
            <LineSegment Point="12.5,8" />
            <LineSegment Point="12.5,12.5" />
            <LineSegment Point="8,12.5" />
        </PathFigure>
    </PathGeometry>

    <!-- Android — rounded body + dots for eyes -->
    <PathGeometry x:Key="IconAndroidGeometry">
        <!-- Body -->
        <PathFigure StartPoint="3,8" IsClosed="True">
            <LineSegment Point="11,8" />
            <LineSegment Point="11,12" />
            <LineSegment Point="3,12" />
        </PathFigure>
        <!-- Head dome -->
        <PathFigure StartPoint="3,7" IsClosed="True">
            <ArcSegment Point="11,7" Size="4,4" SweepDirection="Clockwise" IsLargeArc="False" />
        </PathFigure>
        <!-- Antennas -->
        <PathFigure StartPoint="4.5,2" IsClosed="False">
            <LineSegment Point="5.5,3.5" />
        </PathFigure>
        <PathFigure StartPoint="9.5,2" IsClosed="False">
            <LineSegment Point="8.5,3.5" />
        </PathFigure>
    </PathGeometry>

    <!-- iOS — phone outline with home indicator -->
    <PathGeometry x:Key="IconIOSGeometry">
        <PathFigure StartPoint="4,1.5" IsClosed="True">
            <LineSegment Point="10,1.5" />
            <ArcSegment Point="11.5,3" Size="1.5,1.5" SweepDirection="Clockwise" IsLargeArc="False" />
            <LineSegment Point="11.5,11" />
            <ArcSegment Point="10,12.5" Size="1.5,1.5" SweepDirection="Clockwise" IsLargeArc="False" />
            <LineSegment Point="4,12.5" />
            <ArcSegment Point="2.5,11" Size="1.5,1.5" SweepDirection="Clockwise" IsLargeArc="False" />
            <LineSegment Point="2.5,3" />
            <ArcSegment Point="4,1.5" Size="1.5,1.5" SweepDirection="Clockwise" IsLargeArc="False" />
        </PathFigure>
        <PathFigure StartPoint="6,11" IsClosed="False">
            <LineSegment Point="8,11" />
        </PathFigure>
    </PathGeometry>

    <!-- macOS — apple silhouette -->
    <PathGeometry x:Key="IconMacOSGeometry">
        <PathFigure StartPoint="7,3.5" IsClosed="True">
            <BezierSegment Point1="5,3.5"   Point2="3.5,5"     Point3="3.5,7.5" />
            <BezierSegment Point1="3.5,10"  Point2="5,12"      Point3="6.5,12" />
            <BezierSegment Point1="7.2,12"  Point2="7.5,11.6"  Point3="8,11.6" />
            <BezierSegment Point1="8.5,11.6" Point2="8.8,12"   Point3="9.5,12" />
            <BezierSegment Point1="11,12"   Point2="12.5,10"   Point3="12.5,7.5" />
            <BezierSegment Point1="12.5,5"  Point2="11,3.5"    Point3="9,3.5" />
            <BezierSegment Point1="8,3.5"   Point2="7.6,4"     Point3="7,4" />
            <BezierSegment Point1="6.5,4"   Point2="6.2,3.5"   Point3="5.5,3.5" />
        </PathFigure>
        <!-- Leaf -->
        <PathFigure StartPoint="8,2" IsClosed="False">
            <BezierSegment Point1="8.5,1.2" Point2="9,1" Point3="9.5,1" />
        </PathFigure>
    </PathGeometry>

    <!-- Desktop — monitor with stand -->
    <PathGeometry x:Key="IconDesktopGeometry">
        <PathFigure StartPoint="1.5,2.5" IsClosed="True">
            <LineSegment Point="12.5,2.5" />
            <LineSegment Point="12.5,9.5" />
            <LineSegment Point="1.5,9.5" />
        </PathFigure>
        <PathFigure StartPoint="5,12" IsClosed="False">
            <LineSegment Point="9,12" />
        </PathFigure>
        <PathFigure StartPoint="7,9.5" IsClosed="False">
            <LineSegment Point="7,12" />
        </PathFigure>
    </PathGeometry>

</ResourceDictionary>
