<UserControl x:Class="Composer.Views.Controls.LockedContextCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI">
    <Border Background="{ThemeResource Paper2Brush}"
            BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="20,18">
        <Border.Resources />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header row: [−/+] ✓ LABEL · LOCKED            Revisit -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="ExpandToggle"
                        Style="{StaticResource LinkButtonStyle}"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="{StaticResource TypeBodySmallSize}"
                        Padding="4,2,8,2"
                        Foreground="{ThemeResource Ink4Brush}"
                        Content="−"
                        Click="OnExpandToggleClick" />
                <TextBlock Grid.Column="1"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="{StaticResource TypeEyebrowSize}"
                           CharacterSpacing="160"
                           Foreground="{ThemeResource InkBrush}"
                           VerticalAlignment="Center">
                    <Run Text="✓ " Foreground="{ThemeResource Ink2Brush}" />
                    <Run x:Name="HeaderLabelRun" />
                    <Run Foreground="{ThemeResource Ink3Brush}" Text="  ·  LOCKED" />
                </TextBlock>
                <Button Grid.Column="2"
                        x:Name="RevisitButton"
                        Style="{StaticResource LinkButtonStyle}"
                        Content="Revisit"
                        Click="OnRevisitClick" />
            </Grid>

            <!-- Italic-serif summary -->
            <TextBlock Grid.Row="1"
                       x:Name="SummaryText"
                       FontFamily="{StaticResource SerifLightItalicFontFamily}"
                       FontSize="{StaticResource TypeBodySmallSize}"
                       Foreground="{ThemeResource InkBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />

            <Border Grid.Row="2"
                    x:Name="DividerLine"
                    Height="1"
                    Background="{ThemeResource HairlineBrush}"
                    Margin="0,12,0,12" />

            <!-- 4-fact detail grid (2 columns: label, value × 4 rows) -->
            <Grid Grid.Row="3" x:Name="FactsGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>
    </Border>
</UserControl>
