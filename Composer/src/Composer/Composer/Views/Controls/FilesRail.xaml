<UserControl x:Class="Composer.Views.Controls.FilesRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI">
    <Border Background="{ThemeResource Paper2Brush}"
            BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="1,0,0,0"
            Padding="20,28">
        <utu:AutoLayout Orientation="Vertical" Spacing="14">
            <TextBlock Style="{StaticResource MonoEyebrow}"
                       Text="FILES RAIL" />
            <TextBlock FontFamily="{StaticResource SerifLightItalicFontFamily}"
                       FontSize="{StaticResource TypeBodySmallSize}"
                       Foreground="{ThemeResource Ink3Brush}"
                       TextWrapping="Wrap"
                       Text="Each layer emits files as it locks." />

            <Border Height="1"
                    Background="{ThemeResource HairlineBrush}"
                    Margin="0,4,0,4" />

            <ItemsRepeater x:Name="FileRows">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8,0,8" Opacity="{Binding Opacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0"
                                     Width="8" Height="8"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding DotFill}"
                                     Stroke="{Binding DotStroke}"
                                     StrokeThickness="1" />
                            <TextBlock Grid.Column="1"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource TypeLabelSize}"
                                       Foreground="{ThemeResource InkBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding FileName}" />
                            <TextBlock Grid.Column="2"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource TypeEyebrowMicroSize}"
                                       CharacterSpacing="160"
                                       Foreground="{Binding StatusBadgeBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Text="{Binding StatusBadge}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Height="1"
                    Background="{ThemeResource HairlineBrush}"
                    Margin="0,8,0,8" />
            <TextBlock x:Name="LockedSummary"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="{StaticResource TypeEyebrowSize}"
                       CharacterSpacing="160"
                       Foreground="{ThemeResource Ink3Brush}"
                       Text="0 OF 8 LOCKED" />
        </utu:AutoLayout>
    </Border>
</UserControl>
