<UserControl x:Class="Composer.Views.Controls.Annotation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI">

    <!--
      Annotation — marginalia primitive per docs/DESIGN-BRIEF.md §4.3.

      Italic Inter (or our Sans fallback) behind a 1px left rule. Two voices:
        rationale (default) — plain italic, no quote marks. Used for
                              "Why this X" annotations.
        quote               — italic wrapped in "…". Used for "Agent prompt"
                              content the agent receives verbatim.

      Reads as a developer's margin note — not a called-out warning.
      -->

    <Border BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="1,0,0,0"
            Padding="16,2,0,0">
        <utu:AutoLayout Orientation="Vertical" Spacing="6">
            <TextBlock x:Name="EyebrowText"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="{StaticResource TypeEyebrowMicroSize}"
                       CharacterSpacing="160"
                       FontWeight="Medium"
                       Foreground="{ThemeResource Ink3Brush}" />
            <TextBlock x:Name="BodyText"
                       FontFamily="{StaticResource SerifLightItalicFontFamily}"
                       FontStyle="Italic"
                       FontSize="{StaticResource TypeBodySmallSize}"
                       Foreground="{ThemeResource Ink3Brush}"
                       TextWrapping="Wrap"
                       LineHeight="20" />
        </utu:AutoLayout>
    </Border>
</UserControl>
