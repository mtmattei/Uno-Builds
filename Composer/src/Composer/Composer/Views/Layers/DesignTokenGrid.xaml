<UserControl x:Class="Composer.Views.Layers.DesignTokenGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:Composer.Views.Controls">
    <utu:AutoLayout Orientation="Vertical" Spacing="14">

        <!-- ==== Design canvas card ==== -->
        <Border Background="{ThemeResource PaperBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">
            <utu:AutoLayout Orientation="Vertical" Spacing="0">

                <!-- Header: filename + vision badge + caption -->
                <Grid Padding="28,18,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Prototype DesignCanvas jsx 1591–1594: "design-tokens.md
                         · EDITING" or "· PREVIEW". Vision-input badge stays
                         as a separate amber chip after the meta. -->
                    <utu:AutoLayout Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource TypeLabelSize}"
                                   FontWeight="Medium"
                                   CharacterSpacing="-10"
                                   Foreground="{ThemeResource InkBrush}"
                                   VerticalAlignment="Center"
                                   Text="design-tokens.md" />
                        <TextBlock x:Name="MetaText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource TypeEyebrowSize}"
                                   CharacterSpacing="160"
                                   Foreground="{ThemeResource Ink3Brush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Text="·  EDITING" />
                        <Border x:Name="VisionInputBadge"
                                Background="{ThemeResource AmberBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="VisionInputBadgeText"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource TypeEyebrowMicroSize}"
                                       CharacterSpacing="160"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource InkBrush}"
                                       Text="VISION INPUT" />
                        </Border>
                    </utu:AutoLayout>
                    <TextBlock Grid.Column="1"
                               x:Name="CaptionText"
                               FontFamily="{StaticResource SerifLightItalicFontFamily}"
                               FontSize="{StaticResource TypeLabelSize}"
                               Foreground="{ThemeResource Ink3Brush}"
                               VerticalAlignment="Center"
                               Text="tuned to your description" />
                </Grid>
                <Border Height="1" Background="{ThemeResource HairlineBrush}" />

                <!-- Body: two columns. Tokens + WhyThis on the left, type scale
                     with real sample copy + control gallery on the right. -->
                <Grid Padding="28,20,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <utu:AutoLayout Grid.Column="0" Orientation="Vertical" Spacing="16">

                        <utu:AutoLayout Orientation="Vertical" Spacing="10">
                            <TextBlock Style="{StaticResource MonoEyebrow}" Text="COLOR" />
                            <!-- 4×2 swatch grid (8 tokens) -->
                            <Grid x:Name="ColorGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </utu:AutoLayout>

                        <utu:AutoLayout Orientation="Vertical" Spacing="6">
                            <TextBlock Style="{StaticResource MonoEyebrow}" Text="WHY THIS PALETTE" />
                            <TextBlock x:Name="WhyThisText"
                                       FontFamily="{StaticResource SerifLightItalicFontFamily}"
                                       FontSize="{StaticResource TypeBodySmallSize}"
                                       Foreground="{ThemeResource Ink2Brush}"
                                       TextWrapping="Wrap"
                                       Text="Outdoor sun + a phone in a truck mount means low chroma, high contrast. Action is the only saturated hue and is reserved for the next action — never decoration." />
                        </utu:AutoLayout>

                        <!-- Spacing rhythm tucked under the WhyThis prose -->
                        <utu:AutoLayout Orientation="Vertical" Spacing="10">
                            <TextBlock Style="{StaticResource MonoEyebrow}" Text="SPACING RHYTHM" />
                            <utu:AutoLayout x:Name="SpacingRow" Orientation="Horizontal" Spacing="14" />
                        </utu:AutoLayout>

                    </utu:AutoLayout>

                    <!-- Right column -->
                    <utu:AutoLayout Grid.Column="2" Orientation="Vertical" Spacing="16">

                        <utu:AutoLayout Orientation="Vertical" Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource MonoEyebrow}" Text="TYPE SCALE" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          x:Name="FontCombo"
                                          MinWidth="140"
                                          SelectionChanged="OnFontChanged">
                                    <ComboBoxItem Content="Fraunces" />
                                    <ComboBoxItem Content="Newsreader" />
                                    <ComboBoxItem Content="Inter" />
                                    <ComboBoxItem Content="Geist" />
                                    <ComboBoxItem Content="Geist Mono" />
                                </ComboBox>
                                <!-- Replaces the dropdown when state == previewing
                                     and the body font changed (brief 05 §6). -->
                                <TextBlock Grid.Column="1"
                                           x:Name="FontWasBadge"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="{StaticResource TypeEyebrowSize}"
                                           CharacterSpacing="180"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AmberBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                            <utu:AutoLayout x:Name="TypeScaleStack" Orientation="Vertical" Spacing="8" />
                        </utu:AutoLayout>

                        <!-- Mini control gallery — Primary + TabBar live previews
                             rendered with current Action token. -->
                        <utu:AutoLayout Orientation="Vertical" Spacing="10">
                            <TextBlock Style="{StaticResource MonoEyebrow}" Text="CONTROLS" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{ThemeResource Paper2Brush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14,12">
                                    <utu:AutoLayout Orientation="Vertical" Spacing="8">
                                        <TextBlock Style="{StaticResource MonoEyebrow}" Text="PRIMARY" />
                                        <Border x:Name="PrimaryButtonHost"
                                                CornerRadius="4"
                                                Padding="14,8"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="PrimaryButtonText"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       CharacterSpacing="160"
                                                       Text="ASSIGN TECH" />
                                        </Border>
                                        <Border x:Name="GhostButtonHost"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource HairlineBrush}"
                                                CornerRadius="4"
                                                Padding="14,8"
                                                HorizontalAlignment="Left">
                                            <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       CharacterSpacing="160"
                                                       Foreground="{ThemeResource Ink2Brush}"
                                                       Text="VIEW MAP" />
                                        </Border>
                                    </utu:AutoLayout>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{ThemeResource Paper2Brush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14,12">
                                    <utu:AutoLayout Orientation="Vertical" Spacing="8">
                                        <TextBlock Style="{StaticResource MonoEyebrow}" Text="TAB BAR · TOOLKIT" />
                                        <utu:AutoLayout x:Name="TabBarRow"
                                                        Orientation="Horizontal"
                                                        Spacing="0"
                                                        HorizontalAlignment="Left" />
                                    </utu:AutoLayout>
                                </Border>
                            </Grid>
                        </utu:AutoLayout>

                    </utu:AutoLayout>
                </Grid>

                <!-- Reference screenshots strip — full-width, only shown when
                     the user attached paths on the hero. -->
                <utu:AutoLayout x:Name="ReferenceShotsBlock"
                                Orientation="Vertical"
                                Spacing="10"
                                Padding="28,0,28,24"
                                Visibility="Collapsed">
                    <TextBlock Style="{StaticResource MonoEyebrow}" Text="REFERENCE SHOTS" />
                    <ScrollViewer HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled">
                        <StackPanel x:Name="ReferenceShotsStack"
                                    Orientation="Horizontal"
                                    Spacing="8" />
                    </ScrollViewer>
                </utu:AutoLayout>

            </utu:AutoLayout>
        </Border>

        <!-- ==== Live ColorPaletteOverride.xaml mirror — synthesised from
             the current tokens. Updates as the user picks colors. ==== -->
        <controls:GeneratedFromBlock x:Name="ColorOverrideMirror" />

        <!-- ==== Annotations: rationale + agent guidance per brief §10. -->
        <utu:AutoLayout Orientation="Vertical" Spacing="14" Padding="0,4,0,0">
            <controls:Annotation Eyebrow="WHY THIS FITS"
                                 Voice="rationale"
                                 Body="{Binding WhyThisDesignBody, Mode=OneWay}" />
            <controls:Annotation Eyebrow="AGENT PROMPT"
                                 Voice="quote"
                                 Body="{Binding AgentPromptDesignBody, Mode=OneWay}" />
        </utu:AutoLayout>

    </utu:AutoLayout>
</UserControl>
