<UserControl x:Class="Composer.Views.Layers.IntentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:Composer.Views.Controls">
    <!-- Glass panel — translucent white over Shell's GlassBackdropBrush
         gradient. 20px rounded corners + subtle white inner-edge border +
         32px inner padding so the existing fact-row grid stays readable.
         Per design reference 2026-05-12. -->
    <Border Background="{ThemeResource GlassPanelBrush}"
            BorderBrush="{ThemeResource GlassPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="32,28">
        <utu:AutoLayout Orientation="Vertical" Spacing="14">

            <!-- Title + subtitle moved inside the glass container per user
                 2026-05-12. Title uses 18 Sans Medium (matches the old
                 AppTitleRow style). Subtitle keeps the Body / Ink3 style
                 from the previous ActiveLayerHeader for continuity. -->
            <utu:AutoLayout Orientation="Vertical" Spacing="6" Padding="0,0,0,6">
                <TextBlock Text="What are we building?"
                           FontFamily="{StaticResource SansFontFamily}"
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="{ThemeResource InkBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Fill what you know. I'll infer the rest as we go."
                           Style="{StaticResource Body}"
                           Foreground="{ThemeResource Ink3Brush}"
                           MaxWidth="560"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
            </utu:AutoLayout>

            <!-- ==== Intent canvas card — tabular fact rows ==== -->
            <utu:AutoLayout Orientation="Vertical" Spacing="0">

            <!-- Filename header row: "intent.md · EDITING" — replaces the old
                 bordered card chrome. Hairline divider only, no background. -->
            <Grid Padding="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="{StaticResource TypeLabelSize}"
                           FontWeight="Medium"
                           CharacterSpacing="-10"
                           Foreground="{ThemeResource InkBrush}"
                           Text="intent.md" />
                <TextBlock Grid.Column="1"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="{StaticResource TypeEyebrowSize}"
                           CharacterSpacing="160"
                           Foreground="{ThemeResource Ink3Brush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Text="·  EDITING" />
            </Grid>
            <Border Height="1" Background="{ThemeResource HairlineBrush}" />

            <!-- Example-values banner per v11 interaction brief §4 — shown
                 when any Intent field still matches the field-service
                 archetype defaults. Click Clear all to wipe them. -->
            <Border x:Name="ExampleBanner"
                    Background="{ThemeResource AmberSoftBrush}"
                    BorderBrush="{ThemeResource AmberBrush}"
                    BorderThickness="2,0,0,0"
                    Padding="14,10,14,10"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <!-- Three-column Grid (was Grid+AutoLayout — the inner
                     AutoLayout stretched its children on the cross-axis,
                     misaligning the eyebrow / body / link). Each cell holds
                     one element with VerticalAlignment=Center so baselines
                     hold. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource TypeEyebrowSize}"
                               FontWeight="Medium"
                               CharacterSpacing="160"
                               Foreground="{ThemeResource Ink2Brush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Text="EXAMPLE VALUES" />
                    <TextBlock Grid.Column="1"
                               FontFamily="{StaticResource SerifLightItalicFontFamily}"
                               FontSize="{StaticResource TypeBodySmallSize}"
                               Foreground="{ThemeResource Ink2Brush}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               Text="Tap any field to start your own — or clear to begin fresh." />
                    <Button Grid.Column="2"
                            x:Name="ClearAllButton"
                            Style="{StaticResource LinkButtonStyle}"
                            Content="Clear all"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Click="OnClearAllClick" />
                </Grid>
            </Border>

            <!-- Tabular fact grid — 120px label / 1fr value / 80px proposed
                 column. Each row is a TextBox so the user can edit values
                 in place; ValueChanged fires SetIntent. -->
            <Grid x:Name="FactsGrid" Padding="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Rows are populated in code-behind with one
                     (Eyebrow label, value TextBox, Proposed-or-empty annotation)
                     per IntentValues field. -->
            </Grid>

            <!-- Notes textarea — optional, multi-line, below the fact rows. -->
            <utu:AutoLayout Orientation="Vertical" Spacing="6" Padding="0,16,0,0">
                <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="{StaticResource TypeEyebrowSize}"
                           CharacterSpacing="160"
                           FontWeight="Medium"
                           Foreground="{ThemeResource Ink3Brush}"
                           Text="NOTES" />
                <Border BorderBrush="{ThemeResource HairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,4,0,8">
                    <TextBox x:Name="NotesInput"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FontFamily="{StaticResource SansFontFamily}"
                             FontSize="{StaticResource TypeBodySmallSize}"
                             FontWeight="Normal"
                             Foreground="{ThemeResource Ink2Brush}"
                             PlaceholderForeground="{ThemeResource Ink4Brush}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             PlaceholderText="Anything else worth recording?"
                             AutomationProperties.Name="Intent notes"
                             TextChanged="OnNotesChanged" />
                </Border>
            </utu:AutoLayout>

            <!-- Annotations dropped from Intent canvas per user 2026-05-12.
                 The WHY THIS INTENT + AGENT PROMPT feeds still live on
                 ComposerModel (consumed by the bundle output + reused by
                 other layer canvases) — they're just not rendered here. -->

            </utu:AutoLayout>
        </utu:AutoLayout>
    </Border>
</UserControl>
