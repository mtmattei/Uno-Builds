<UserControl x:Class="Composer.Views.Layers.UXFlowStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:Composer.Views.Controls">
    <utu:AutoLayout Orientation="Vertical" Spacing="14">

        <Border Background="{ThemeResource PaperBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">
            <utu:AutoLayout Orientation="Vertical" Spacing="0">

                <!-- Filename / badge / meta header — matches prototype's
                     UXCanvas section header (jsx lines 1265–1267):
                     "dispatch-flow.md · 5 SCREENS" + right-aligned italic
                     meta. FlowNameText is the filename (mono label, tight
                     tracking); MetaText is the dot-prefixed status badge
                     in mono eyebrow with looser tracking. -->
                <Grid Padding="28,18,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="FlowNameText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource TypeLabelSize}"
                               FontWeight="Medium"
                               CharacterSpacing="-10"
                               Foreground="{ThemeResource InkBrush}"
                               VerticalAlignment="Center"
                               Text="ux-flows.md" />
                    <TextBlock Grid.Column="1"
                               x:Name="MetaText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource TypeEyebrowSize}"
                               CharacterSpacing="160"
                               Foreground="{ThemeResource Ink3Brush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <TextBlock Grid.Column="3"
                               x:Name="FlowCaptionText"
                               FontFamily="{StaticResource SerifLightItalicFontFamily}"
                               FontSize="{StaticResource TypeLabelSize}"
                               Foreground="{ThemeResource Ink3Brush}"
                               VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Background="{ThemeResource HairlineBrush}" />

                <ScrollViewer HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              Padding="20,18,20,18">
                    <StackPanel x:Name="TileStack"
                                Orientation="Horizontal"
                                Spacing="14" />
                </ScrollViewer>
            </utu:AutoLayout>
        </Border>

        <!-- ==== Annotations: rationale + agent guidance.
             Prototype UXCanvas lines 1296–1305 — every layer canvas surfaces
             a WhyThis + AgentPrompt pair. Voice="quote" wraps the agent line
             in curly double-quotes because the agent reads it verbatim. -->
        <utu:AutoLayout Orientation="Vertical" Spacing="14" Padding="0,4,0,0">
            <controls:Annotation Eyebrow="WHY THIS FLOW"
                                 Voice="rationale"
                                 Body="{Binding WhyThisFlowBody, Mode=OneWay}" />
            <controls:Annotation Eyebrow="AGENT PROMPT"
                                 Voice="quote"
                                 Body="{Binding AgentPromptFlowBody, Mode=OneWay}" />
        </utu:AutoLayout>

    </utu:AutoLayout>
</UserControl>
