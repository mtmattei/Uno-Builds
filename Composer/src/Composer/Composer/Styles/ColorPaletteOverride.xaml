<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <!--
    Material colour palette mapped to the editorial monochromatic system.
    The composer is locked to a single light treatment by deliberate choice;
    the Dark dictionary therefore mirrors Light to prevent OS-driven flips.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#18181B</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#F4F4F5</Color>
      <Color x:Key="OnPrimaryContainerColor">#18181B</Color>
      <Color x:Key="SecondaryColor">#3F3F46</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#FAFAFA</Color>
      <Color x:Key="OnSecondaryContainerColor">#18181B</Color>
      <Color x:Key="TertiaryColor">#71717A</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#F4F4F5</Color>
      <Color x:Key="OnTertiaryContainerColor">#18181B</Color>
      <Color x:Key="ErrorColor">#DC2626</Color>
      <Color x:Key="ErrorContainerColor">#FEE2E2</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#7F1D1D</Color>
      <Color x:Key="BackgroundColor">#F4F4F5</Color>
      <Color x:Key="OnBackgroundColor">#18181B</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#18181B</Color>
      <Color x:Key="SurfaceVariantColor">#FAFAFA</Color>
      <Color x:Key="OnSurfaceVariantColor">#3F3F46</Color>
      <Color x:Key="OutlineColor">#E4E4E7</Color>
      <Color x:Key="OnSurfaceInverseColor">#FAFAFA</Color>
      <Color x:Key="SurfaceInverseColor">#18181B</Color>
      <Color x:Key="PrimaryInverseColor">#FAFAFA</Color>
      <Color x:Key="SurfaceTintColor">#18181B</Color>
      <Color x:Key="OutlineVariantColor">#E4E4E7</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#18181B</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#F4F4F5</Color>
      <Color x:Key="OnPrimaryContainerColor">#18181B</Color>
      <Color x:Key="SecondaryColor">#3F3F46</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#FAFAFA</Color>
      <Color x:Key="OnSecondaryContainerColor">#18181B</Color>
      <Color x:Key="TertiaryColor">#71717A</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#F4F4F5</Color>
      <Color x:Key="OnTertiaryContainerColor">#18181B</Color>
      <Color x:Key="ErrorColor">#DC2626</Color>
      <Color x:Key="ErrorContainerColor">#FEE2E2</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#7F1D1D</Color>
      <Color x:Key="BackgroundColor">#F4F4F5</Color>
      <Color x:Key="OnBackgroundColor">#18181B</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#18181B</Color>
      <Color x:Key="SurfaceVariantColor">#FAFAFA</Color>
      <Color x:Key="OnSurfaceVariantColor">#3F3F46</Color>
      <Color x:Key="OutlineColor">#E4E4E7</Color>
      <Color x:Key="OnSurfaceInverseColor">#FAFAFA</Color>
      <Color x:Key="SurfaceInverseColor">#18181B</Color>
      <Color x:Key="PrimaryInverseColor">#FAFAFA</Color>
      <Color x:Key="SurfaceTintColor">#18181B</Color>
      <Color x:Key="OutlineVariantColor">#E4E4E7</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
