<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>MsnMessenger</ApplicationTitle>
    <ApplicationId>com.companyname.msnmessenger</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>MsnMessenger</ApplicationPublisher>
    <Description>MsnMessenger powered by Uno Platform.</Description>

    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
