<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base style for all Sonar terminal typography -->
  <Style x:Key="SonarBaseTextBlockStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Courier New, Consolas, monospace" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen100Brush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- App Title Style -->
  <Style x:Key="SonarTitleTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="28" />
  </Style>

  <!-- Subtitle Style -->
  <Style x:Key="SonarSubtitleTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen53Brush}" />
  </Style>

  <!-- Contact Count Style -->
  <Style x:Key="SonarCountTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Contact Count Label Style -->
  <Style x:Key="SonarCountLabelTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen53Brush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Status Bar Style -->
  <Style x:Key="SonarStatusBarTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Section Header Style -->
  <Style x:Key="SonarSectionHeaderTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen53Brush}" />
  </Style>

  <!-- Contact Name Style -->
  <Style x:Key="SonarContactNameTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Contact Info Style -->
  <Style x:Key="SonarContactInfoTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen53Brush}" />
  </Style>

  <!-- Button Text Style -->
  <Style x:Key="SonarButtonTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- Center Label Style -->
  <Style x:Key="SonarCenterLabelTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Distance Labels Style -->
  <Style x:Key="SonarDistanceLabelTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen33Brush}" />
  </Style>

  <!-- Blip Label Style -->
  <Style x:Key="SonarBlipLabelTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Bearing Label Style (N/S/E/W around radar) -->
  <Style x:Key="SonarBearingLabelTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SonarBaseTextBlockStyle}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{ThemeResource PhosphorGreen33Brush}" />
  </Style>

</ResourceDictionary>
