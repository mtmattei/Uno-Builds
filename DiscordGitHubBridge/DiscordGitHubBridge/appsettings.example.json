{
  "_comment": "Copy the non-secret parts into appsettings.json. Secrets go in user-secrets (local) or environment variables (Discord__Token, GitHub__Auth__PrivateKeyPem). Never commit them.",

  "Discord": {
    "Token": "<secret: Discord__Token>"
  },

  "GitHub": {
    "Owner": "your-org",
    "Repository": "your-repo",
    "Auth": {
      "Mode": "App",
      "AppId": 0,
      "InstallationId": 0,
      "PrivateKeyPath": "<path to the GitHub App .pem, or set GitHub__Auth__PrivateKeyPem>",
      "Token": "<Pat mode only: GitHub__Auth__Token>"
    }
  },

