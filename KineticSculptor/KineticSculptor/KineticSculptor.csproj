<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-browserwasm;net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>KineticSculptor</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.kineticsculptor</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>KineticSculptor</ApplicationPublisher>
    <!-- Package Description -->
    <Description>KineticSculptor powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>

    <!-- Pinning SkiaSharp 4.x preview while Uno.Sdk 6.5.31 still bundles 3.x. -->
    <UnoDisableLottieSkiaVersionCheck>true</UnoDisableLottieSkiaVersionCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <!-- WASM static-link needs native syms matching the managed SkiaSharp 4 preview. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-browserwasm'">
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
  </ItemGroup>

  <!-- Desktop on Windows: pin matching native lib so 4.x P/Invokes don't crash on shutdown. -->
  <!-- macOS/Linux desktop runs would need .macOS / .Linux.NoDependencies added similarly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-desktop'">
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

</Project>
