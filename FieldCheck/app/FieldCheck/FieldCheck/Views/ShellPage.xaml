<Page x:Class="FieldCheck.Views.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:FieldCheck.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      KeyboardAcceleratorPlacementMode="Hidden"
      Background="{StaticResource CanvasBrush}">

  <Grid x:Name="Root" utu:SafeArea.Insets="VisibleBounds">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Wide: persistent sidebar -->
    <Grid x:Name="Sidebar"
          Grid.RowSpan="2"
          Width="232"
          Visibility="Collapsed"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource RuleBrush}"
          BorderThickness="0,0,1,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="30,27,32,0">
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource MicroLabelStyle}"
                   Foreground="{StaticResource InkBrush}"
                   FontSize="12"
                   FontWeight="Medium"
                   Text="FIELDCHECK" />
        <Border Width="35" Height="35" HorizontalAlignment="Right" CornerRadius="6" Background="{StaticResource AccentBrush}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{StaticResource InkBrush}" Text="F" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,46,15,0" Spacing="9">
        <Button Style="{StaticResource NavButtonStyle}" Height="43" Command="{x:Bind ViewModel.ShowDashboardCommand}" AutomationProperties.Name="Dashboard">
          <Grid>
            <Border Background="{StaticResource CanvasBrush}" CornerRadius="8" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsDashboardActive), Mode=OneWay}" />
            <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsDashboardActive), Mode=OneWay}" />
            <Path Margin="16,0,0,0" HorizontalAlignment="Left" Style="{StaticResource IconPathStyle}" Stroke="{x:Bind c:StatusVisuals.Nav(ViewModel.IsDashboardActive), Mode=OneWay}"
                  Data="M3,3 L10,3 L10,12 L3,12 Z M14,3 L21,3 L21,8 L14,8 Z M14,12 L21,12 L21,21 L14,21 Z M3,16 L10,16 L10,21 L3,21 Z" />
            <TextBlock Margin="52,0,0,0" VerticalAlignment="Center" FontSize="15" Text="Dashboard" Foreground="{x:Bind c:StatusVisuals.Nav(ViewModel.IsDashboardActive), Mode=OneWay}" />
          </Grid>
        </Button>
        <Button Style="{StaticResource NavButtonStyle}" Height="43" Command="{x:Bind ViewModel.ShowAssetsCommand}" AutomationProperties.Name="Assets">
          <Grid>
            <Border Background="{StaticResource CanvasBrush}" CornerRadius="8" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsAssetsActive), Mode=OneWay}" />
            <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsAssetsActive), Mode=OneWay}" />
            <Path Margin="16,0,0,0" HorizontalAlignment="Left" Style="{StaticResource IconPathStyle}" Stroke="{x:Bind c:StatusVisuals.Nav(ViewModel.IsAssetsActive), Mode=OneWay}"
                  Data="M12,2.5 L21.5,12 L12,21.5 L2.5,12 Z" />
            <TextBlock Margin="52,0,0,0" VerticalAlignment="Center" FontSize="15" Text="Assets" Foreground="{x:Bind c:StatusVisuals.Nav(ViewModel.IsAssetsActive), Mode=OneWay}" />
          </Grid>
        </Button>
        <Button Style="{StaticResource NavButtonStyle}" Height="43" Command="{x:Bind ViewModel.ShowHistoryCommand}" AutomationProperties.Name="History">
          <Grid>
            <Border Background="{StaticResource CanvasBrush}" CornerRadius="8" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsHistoryActive), Mode=OneWay}" />
            <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsHistoryActive), Mode=OneWay}" />
            <Path Margin="16,0,0,0" HorizontalAlignment="Left" Style="{StaticResource IconPathStyle}" Stroke="{x:Bind c:StatusVisuals.Nav(ViewModel.IsHistoryActive), Mode=OneWay}"
                  Data="M5,4 L19,4 M5,9 L19,9 M5,14 L13,14 M5,19 L10,19 M17,13 L17,19 L21,19" />
            <TextBlock Margin="52,0,0,0" VerticalAlignment="Center" FontSize="15" Text="History" Foreground="{x:Bind c:StatusVisuals.Nav(ViewModel.IsHistoryActive), Mode=OneWay}" />
          </Grid>
        </Button>
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="30,0,16,28" Spacing="4">
        <TextBlock FontSize="13" Foreground="{StaticResource InkBrush}" Text="Alex Morgan" />
        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Facility A" />
      </StackPanel>
    </Grid>

    <Frame x:Name="ContentFrame" Grid.Column="1" />

    <!-- Narrow: bottom navigation, only on the three section roots -->
    <Grid x:Name="BottomNavHost" Grid.Row="1" Grid.ColumnSpan="2">
      <Grid Height="72"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource RuleBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsOnSectionRoot), Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource NavButtonStyle}" CornerRadius="0" Command="{x:Bind ViewModel.ShowDashboardCommand}" AutomationProperties.Name="Dashboard">
          <Grid>
            <Border Width="54" Height="4" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsDashboardActive), Mode=OneWay}" />
            <StackPanel VerticalAlignment="Center" Margin="0,8,0,0" Spacing="6">
              <Path HorizontalAlignment="Center" Style="{StaticResource IconPathStyle}" Stroke="{x:Bind c:StatusVisuals.Nav(ViewModel.IsDashboardActive), Mode=OneWay}"
                    Data="M3,3 L10,3 L10,12 L3,12 Z M14,3 L21,3 L21,8 L14,8 Z M14,12 L21,12 L21,21 L14,21 Z M3,16 L10,16 L10,21 L3,21 Z" />
              <TextBlock HorizontalAlignment="Center" FontSize="12" Text="Dashboard" Foreground="{x:Bind c:StatusVisuals.Nav(ViewModel.IsDashboardActive), Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource NavButtonStyle}" CornerRadius="0" Command="{x:Bind ViewModel.ShowAssetsCommand}" AutomationProperties.Name="Assets">
          <Grid>
            <Border Width="54" Height="4" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsAssetsActive), Mode=OneWay}" />
            <StackPanel VerticalAlignment="Center" Margin="0,8,0,0" Spacing="6">
              <Path HorizontalAlignment="Center" Style="{StaticResource IconPathStyle}" Stroke="{x:Bind c:StatusVisuals.Nav(ViewModel.IsAssetsActive), Mode=OneWay}"
                    Data="M12,2.5 L21.5,12 L12,21.5 L2.5,12 Z" />
              <TextBlock HorizontalAlignment="Center" FontSize="12" Text="Assets" Foreground="{x:Bind c:StatusVisuals.Nav(ViewModel.IsAssetsActive), Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" CornerRadius="0" Command="{x:Bind ViewModel.ShowHistoryCommand}" AutomationProperties.Name="History">
          <Grid>
            <Border Width="54" Height="4" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(ViewModel.IsHistoryActive), Mode=OneWay}" />
            <StackPanel VerticalAlignment="Center" Margin="0,8,0,0" Spacing="6">
              <Path HorizontalAlignment="Center" Style="{StaticResource IconPathStyle}" Stroke="{x:Bind c:StatusVisuals.Nav(ViewModel.IsHistoryActive), Mode=OneWay}"
                    Data="M5,4 L19,4 M5,9 L19,9 M5,14 L13,14 M5,19 L10,19 M17,13 L17,19 L21,19" />
              <TextBlock HorizontalAlignment="Center" FontSize="12" Text="History" Foreground="{x:Bind c:StatusVisuals.Nav(ViewModel.IsHistoryActive), Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </Button>
      </Grid>
    </Grid>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Sidebar.Visibility" Value="Visible" />
            <Setter Target="BottomNavHost.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>
