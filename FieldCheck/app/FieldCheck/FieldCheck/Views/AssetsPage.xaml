<Page x:Class="FieldCheck.Views.AssetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:FieldCheck.Controls"
      xmlns:vm="using:FieldCheck.ViewModels"
      xmlns:v="using:FieldCheck.Views"
      NavigationCacheMode="Required"
      Background="{StaticResource CanvasBrush}">

  <Page.Resources>
    <DataTemplate x:Key="NarrowRowTemplate" x:DataType="vm:AssetRow">
      <Button Style="{StaticResource RowButtonStyle}" Click="OnAssetClick" AutomationProperties.Name="{x:Bind SpokenText}">
        <Grid Padding="0,13,0,13" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Style="{StaticResource RowTitleStyle}" Text="{x:Bind Name}" />
            <TextBlock Style="{StaticResource SecondaryStyle}" Text="{x:Bind IdAndType}" />
            <TextBlock Style="{StaticResource SecondaryStyle}" Text="{x:Bind Location}" />
          </StackPanel>
          <c:StatusChip Grid.Column="1" Status="{x:Bind StatusText}" />
          <Path Grid.Column="2" Width="12" Height="12" Style="{StaticResource IconPathStyle}" StrokeThickness="2" Data="M9,5 L16,12 L9,19" />
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="WideRowTemplate" x:DataType="vm:AssetRow">
      <Button Style="{StaticResource RowButtonStyle}" Click="OnAssetClick" AutomationProperties.Name="{x:Bind SpokenText}">
        <Grid Height="84" Background="{x:Bind c:StatusVisuals.SelectedFill(IsSelected), Mode=OneWay}">
          <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="{x:Bind c:StatusVisuals.Show(IsSelected), Mode=OneWay}" />
          <Grid Padding="20,0,20,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="5">
              <TextBlock Style="{StaticResource RowTitleStyle}" FontSize="15" Text="{x:Bind Name}" />
              <TextBlock Style="{StaticResource SecondaryStyle}" FontSize="11" Text="{x:Bind IdAndLocation}" />
            </StackPanel>
            <c:StatusChip Grid.Column="1" Status="{x:Bind StatusText}" />
          </Grid>
        </Grid>
      </Button>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="MasterColumn" Width="*" />
      <ColumnDefinition x:Name="DetailColumn" Width="0" />
    </Grid.ColumnDefinitions>

    <!-- Master: search, filters, rows -->
    <Grid x:Name="Master" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel x:Name="Header" Padding="20,40,20,0">
        <TextBlock Style="{StaticResource ScreenTitleStyle}" Text="Assets" />
        <TextBlock Margin="0,1,0,0" Style="{StaticResource SecondaryStyle}" FontSize="13" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

        <Grid Margin="0,14,0,0">
          <TextBox x:Name="Search"
                   Style="{StaticResource SearchTextBoxStyle}"
                   PlaceholderText="Search assets"
                   InputScope="Search"
                   AutomationProperties.Name="Search assets by name, ID, type or location"
                   Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Path Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16" IsHitTestVisible="False"
                Style="{StaticResource IconPathStyle}" Stroke="{StaticResource MutedBrush}"
                Data="M10,3 C13.9,3 17,6.1 17,10 C17,13.9 13.9,17 10,17 C6.1,17 3,13.9 3,10 C3,6.1 6.1,3 10,3 Z M15,15 L21,21" />
        </Grid>

        <ScrollViewer Margin="0,6,0,4" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="Status filter">
            <RadioButton GroupName="AssetFilter" Style="{StaticResource ChipRadioButtonStyle}" Content="All" IsChecked="{x:Bind ViewModel.IsAll, Mode=TwoWay}" AutomationProperties.Name="Show all statuses" />
            <RadioButton GroupName="AssetFilter" Style="{StaticResource ChipRadioButtonStyle}" Content="Operational" IsChecked="{x:Bind ViewModel.IsOperational, Mode=TwoWay}" AutomationProperties.Name="Filter Operational" />
            <RadioButton GroupName="AssetFilter" Style="{StaticResource ChipRadioButtonStyle}" Content="Attention" IsChecked="{x:Bind ViewModel.IsAttention, Mode=TwoWay}" AutomationProperties.Name="Filter Attention" />
            <RadioButton GroupName="AssetFilter" Style="{StaticResource ChipRadioButtonStyle}" Content="Critical" IsChecked="{x:Bind ViewModel.IsCritical, Mode=TwoWay}" AutomationProperties.Name="Filter Critical" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>

      <Grid Grid.Row="1">
        <c:StatePanel x:Name="States"
                      Margin="20,0,20,0"
                      VerticalAlignment="Top"
                      State="{x:Bind ViewModel.State, Mode=OneWay}"
                      RetryCommand="{x:Bind ViewModel.LoadCommand}"
                      LoadingText="Loading assets…"
                      EmptyTitle="No assets registered"
                      EmptyMessage="The local asset register is empty. Assets appear here once they are added to this device's data." />

        <StackPanel x:Name="NoResults" Margin="20,28,20,0" Spacing="8" Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}">
          <TextBlock Style="{StaticResource SectionTitleStyle}" Text="No matching assets" />
          <TextBlock Style="{StaticResource SecondaryStyle}" FontSize="14" Text="Try a different name, ID, type or location, or clear the status filter." />
          <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}" MinWidth="160" HorizontalAlignment="Left" Content="Clear search" Command="{x:Bind ViewModel.ClearSearchCommand}" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
          <ItemsControl x:Name="List"
                        Margin="20,0,20,20"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        ItemTemplate="{StaticResource NarrowRowTemplate}"
                        AutomationProperties.Name="Asset list" />
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Detail (wide only) -->
    <Grid x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed">
      <ScrollViewer>
        <v:AssetDetailView Margin="47,46,47,40" ViewModel="{x:Bind ViewModel.Detail}" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
      </ScrollViewer>
      <StackPanel Margin="47,52,47,0" Spacing="8" Visibility="{x:Bind ViewModel.ShowSelectionPrompt, Mode=OneWay}">
        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Select an asset" />
        <TextBlock Style="{StaticResource SecondaryStyle}" FontSize="14" Text="Choose an asset from the list to see its details and start an inspection." />
      </StackPanel>
    </Grid>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Medium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Header.Padding" Value="40,44,40,0" />
            <Setter Target="States.Margin" Value="40,0,40,0" />
            <Setter Target="NoResults.Margin" Value="40,28,40,0" />
            <Setter Target="List.Margin" Value="40,0,40,20" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1000" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="MasterColumn.Width" Value="380" />
            <Setter Target="DetailColumn.Width" Value="*" />
            <Setter Target="DetailPane.Visibility" Value="Visible" />
            <Setter Target="Master.Background" Value="{StaticResource CanvasRaisedBrush}" />
            <Setter Target="Master.BorderThickness" Value="0,0,1,0" />
            <Setter Target="Header.Padding" Value="40,44,40,0" />
            <Setter Target="States.Margin" Value="40,0,40,0" />
            <Setter Target="NoResults.Margin" Value="40,28,40,0" />
            <Setter Target="List.Margin" Value="20,6,20,20" />
            <Setter Target="List.ItemTemplate" Value="{StaticResource WideRowTemplate}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="MasterCompact" />
        <VisualState x:Name="MasterFull">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1280" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="MasterColumn.MaxWidth" Value="461" />
            <Setter Target="MasterColumn.MinWidth" Value="461" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>
