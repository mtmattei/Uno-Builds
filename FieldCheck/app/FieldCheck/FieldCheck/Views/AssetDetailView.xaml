<UserControl x:Class="FieldCheck.Views.AssetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:FieldCheck.Controls">

  <Grid>
    <c:StatePanel State="{x:Bind ViewModel.State, Mode=OneWay}"
                  RetryCommand="{x:Bind ViewModel.LoadCommand, Mode=OneWay}"
                  LoadingText="Loading asset…"
                  EmptyTitle="Asset not found"
                  EmptyMessage="This asset is no longer in the local register." />

    <StackPanel Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
      <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="10">
          <TextBlock x:Name="AssetName" Style="{StaticResource ScreenTitleStyle}" Text="{x:Bind ViewModel.Asset.Name, Mode=OneWay}" />
          <c:StatusChip Status="{x:Bind ViewModel.Asset.StatusText, Mode=OneWay}" />
        </StackPanel>
        <Button x:Name="WideStartButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                MinWidth="199"
                Visibility="Collapsed"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{x:Bind ViewModel.StartInspectionCommand, Mode=OneWay}"
                Content="Start inspection" />
      </Grid>

      <Grid x:Name="Sheet" Margin="0,30,0,0" RowSpacing="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
          <TextBlock Style="{StaticResource MicroLabelStyle}" Text="ASSET ID" />
          <TextBlock Style="{StaticResource BodyStyle}" FontSize="16" Text="{x:Bind ViewModel.Asset.Id, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Style="{StaticResource MicroLabelStyle}" Text="TYPE" />
          <TextBlock Style="{StaticResource BodyStyle}" FontSize="16" Text="{x:Bind ViewModel.Asset.Type, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
          <TextBlock Style="{StaticResource MicroLabelStyle}" Text="LOCATION" />
          <TextBlock Style="{StaticResource BodyStyle}" FontSize="16" Text="{x:Bind ViewModel.Asset.Location, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
          <TextBlock Style="{StaticResource MicroLabelStyle}" Text="LAST INSPECTION" />
          <TextBlock Style="{StaticResource BodyStyle}" FontSize="16" Text="{x:Bind ViewModel.LastInspectionText, Mode=OneWay}" />
        </StackPanel>
      </Grid>

      <Border Margin="0,26,0,0" Style="{StaticResource RuleStyle}" />
      <TextBlock Margin="0,28,0,0" Style="{StaticResource MicroLabelStyle}" Text="DESCRIPTION" />
      <TextBlock x:Name="Description"
                 Margin="0,14,0,0"
                 Style="{StaticResource BodyStyle}"
                 LineHeight="22"
                 IsTextSelectionEnabled="True"
                 Text="{x:Bind ViewModel.Asset.Description, Mode=OneWay}" />

      <Border Margin="0,40,0,0" Style="{StaticResource RuleStyle}" />
      <TextBlock Margin="0,28,0,0" Style="{StaticResource MicroLabelStyle}" Text="LATEST INSPECTION" />
      <StackPanel Margin="0,14,0,0" Spacing="6" Visibility="{x:Bind ViewModel.HasLatestInspection, Mode=OneWay}">
        <TextBlock FontSize="19"
                   Foreground="{x:Bind c:StatusVisuals.Foreground(ViewModel.LatestConditionText), Mode=OneWay}"
                   Text="{x:Bind ViewModel.LatestTitle, Mode=OneWay}" />
        <TextBlock x:Name="LatestSummary" MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource SecondaryStyle}" FontSize="13" LineHeight="20" Text="{x:Bind ViewModel.LatestSummary, Mode=OneWay}" />
        <TextBlock Style="{StaticResource SecondaryStyle}" FontSize="12" Text="{x:Bind ViewModel.LatestMeta, Mode=OneWay}" />
      </StackPanel>
      <TextBlock Margin="0,14,0,0"
                 Style="{StaticResource BodyStyle}"
                 Foreground="{StaticResource MutedBrush}"
                 Visibility="{x:Bind ViewModel.HasNoInspection, Mode=OneWay}"
                 Text="No inspections recorded yet." />

      <Button x:Name="NarrowStartButton"
              Margin="0,56,0,24"
              HorizontalAlignment="Stretch"
              Style="{StaticResource PrimaryButtonStyle}"
              Command="{x:Bind ViewModel.StartInspectionCommand, Mode=OneWay}"
              Content="Start inspection" />
    </StackPanel>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1000" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="WideStartButton.Visibility" Value="Visible" />
            <Setter Target="NarrowStartButton.Visibility" Value="Collapsed" />
            <Setter Target="Description.MaxWidth" Value="620" />
            <Setter Target="Description.HorizontalAlignment" Value="Left" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</UserControl>
