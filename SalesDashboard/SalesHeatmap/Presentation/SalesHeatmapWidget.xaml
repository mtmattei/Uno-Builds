<UserControl x:Class="SalesHeatmap.Presentation.SalesHeatmapWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SalesHeatmap.Presentation">

    <Border CornerRadius="16"
            Padding="2"
            Background="{ThemeResource OutlineBrush}">

        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="14"
                Padding="24">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SALES OVERVIEW"
                               FontFamily="{StaticResource WidgetMonoFamily}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{ThemeResource OnSurfaceBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveIndicator"
                                 Width="8" Height="8"
                                 Fill="{ThemeResource PrimaryBrush}"/>
                        <TextBlock Text="LIVE"
                                   FontFamily="{StaticResource WidgetMonoFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource BackgroundBrush}"
                        CornerRadius="8"
                        Padding="12"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1">
                    <Grid x:Name="HeatmapGrid" HorizontalAlignment="Center" />
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock Text="MONTHLY"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="MonthlyValue"
                                   FontFamily="{StaticResource WidgetMonoFamily}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource OnSurfaceBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="MonthlyChangeIcon"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"/>
                            <TextBlock x:Name="MonthlyChangeValue"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock Text="YEARLY"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="YearlyValue"
                                   FontFamily="{StaticResource WidgetMonoFamily}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource OnSurfaceBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="YearlyChangeIcon"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"/>
                            <TextBlock x:Name="YearlyChangeValue"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3"
                        Background="{ThemeResource SurfaceContainerBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="TOP REGIONS"
                                   FontFamily="{StaticResource WidgetMonoFamily}"
                                   FontSize="11"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Los Angeles"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="14"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock x:Name="LAValue"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="LAChange"
                                       Grid.Column="2"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="New York"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="14"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock x:Name="NYValue"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="NYChange"
                                       Grid.Column="2"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Canada"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="14"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock x:Name="CAValue"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="CAChange"
                                       Grid.Column="2"
                                       FontFamily="{StaticResource WidgetMonoFamily}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
