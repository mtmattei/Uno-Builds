<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Inline AI chat feature theme, mapped onto Freewrite's quiet paper palette
    (Styles/ColorPaletteOverride.xaml) rather than raw Material keys. Editorial pairing:
    Newsreader (serif) for reading prose, JetBrains Mono for chrome — Freewrite's own
    families, so the AI surface matches the editor instead of looking Material-default.
  -->
  <FontFamily x:Key="ReadingFontFamily">Newsreader</FontFamily>
  <FontFamily x:Key="MonoFontFamily">JetBrains Mono</FontFamily>

  <!-- Held-selection band + AI focal tint: a single ink accent at low opacity (no color, by design). -->
  <SolidColorBrush x:Key="SelectionHighlightBrush"
                   Color="{ThemeResource FreewriteOnSurfaceColor}"
                   Opacity="0.16" />
  <SolidColorBrush x:Key="AiSoftAccentBrush"
                   Color="{ThemeResource FreewriteOnSurfaceColor}"
                   Opacity="0.08" />

  <!-- Reading text: AI prose, user bubble. Serif, explicit sizing (matches Styles/TextBlock.xaml convention). -->
  <Style x:Key="AiReadingTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NewsreaderFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    <Setter Property="Foreground" Value="{ThemeResource EditorTextBrush}" />
  </Style>

  <!-- Chrome label: quick-action chips, identity title — mono, tracked, de-emphasized. -->
  <Style x:Key="AiChromeLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="CharacterSpacing" Value="90" />
    <Setter Property="Foreground" Value="{ThemeResource ChromeIconBrushInactive}" />
  </Style>

  <!-- Micro chrome: context-chip caption, toast. -->
  <Style x:Key="AiChromeMicroStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LineHeight" Value="13" />
    <Setter Property="CharacterSpacing" Value="110" />
    <Setter Property="Foreground" Value="{ThemeResource ChromeIconBrushInactive}" />
  </Style>

</ResourceDictionary>
