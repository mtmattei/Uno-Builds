<Page x:Class="FreewriteUno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FreewriteUno"
      xmlns:vm="using:FreewriteUno.ViewModels"
      xmlns:models="using:FreewriteUno.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      RequestedTheme="{x:Bind ViewModel.Theme, Mode=OneWay}"
      Background="{ThemeResource EditorBackgroundBrush}">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewEntryAccelerator" />
    <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="OnToggleSidebarAccelerator" />
    <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnToggleTimerAccelerator" />
    <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
  </Page.KeyboardAccelerators>


  <Page.Resources>
    <!-- Editor TextBox: chromeless -->
    <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Foreground" Value="{ThemeResource EditorTextBrush}" />
      <Setter Property="SelectionHighlightColor" Value="{ThemeResource EditorSelectionBrush}" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Chrome icon button: transparent, minimal, hover lights the foreground -->
    <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Foreground" Value="{ThemeResource ChromeIconBrushInactive}" />
      <Setter Property="FontFamily" Value="{StaticResource LatoFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ChromeTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeIconButtonStyle}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="40" />
    </Style>

    <!-- Sidebar row template -->
    <DataTemplate x:Key="SidebarRowTemplate" x:DataType="models:Entry">
      <Grid Padding="12,12,12,12" RowSpacing="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{x:Bind vm:Formatters.FormatEntryPreview((models:Entry))}"
                   Opacity="{x:Bind vm:Formatters.EntryPreviewOpacity((models:Entry))}"
                   Style="{StaticResource SidebarPreviewTextStyle}" />
        <TextBlock Grid.Row="1"
                   Text="{x:Bind vm:Formatters.FormatRelativeDate(CreatedAt)}"
                   Style="{StaticResource SidebarDateTextStyle}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <SplitView x:Name="RootSplitView"
               IsPaneOpen="{x:Bind ViewModel.IsSidebarOpen, Mode=TwoWay}"
               DisplayMode="Overlay"
               PanePlacement="Right"
               OpenPaneLength="280"
               PaneBackground="{ThemeResource EditorBackgroundBrush}">

      <SplitView.Pane>
        <Grid Padding="16,32,16,24" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="{ThemeResource ChromeOutlineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="HISTORY"
                         Style="{StaticResource SidebarHeaderTextStyle}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Style="{StaticResource ChromeIconButtonStyle}"
                      Command="{x:Bind ViewModel.ShowEntriesFolderCommand}"
                      Content="&#x1F4C2;"
                      AutomationProperties.Name="Show entries folder"
                      ToolTipService.ToolTip="Open entries folder in file manager" />
            </Grid>
          </Border>

          <ListView Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                    ItemTemplate="{StaticResource SidebarRowTemplate}"
                    SelectionMode="Single"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </ListView.ItemContainerStyle>
          </ListView>
        </Grid>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid x:Name="EditorRoot" Background="{ThemeResource EditorBackgroundBrush}">
          <!-- Editor surface -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Padding="48,48,48,112">
            <Grid HorizontalAlignment="Center" MaxWidth="720">
              <!-- Placeholder behind the editor TextBox. Same leading newlines so it
                   aligns with where the cursor sits. The Grid is intentionally
                   auto-sized + centered so writing begins in the middle of the
                   viewport and grows outward as text is typed (original spec). -->
              <TextBlock x:Name="PlaceholderText"
                         Text="&#10;&#10;What's on your mind?"
                         FontFamily="{x:Bind FontFamilyForName(ViewModel.SelectedFont), Mode=OneWay}"
                         FontSize="{x:Bind ViewModel.FontSize, Mode=OneWay}"
                         Opacity="{x:Bind vm:Formatters.PlaceholderOpacity(ViewModel.Text), Mode=OneWay}"
                         IsHitTestVisible="False"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top">
                <TextBlock.Foreground>
                  <SolidColorBrush x:Name="PlaceholderShimmerBrush"
                                   Color="{ThemeResource FreewriteOnSurfaceColor}"
                                   Opacity="0.35" />
                </TextBlock.Foreground>
              </TextBlock>
              <TextBox x:Name="EditorTextBox"
                       Style="{StaticResource EditorTextBoxStyle}"
                       Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="{x:Bind FontFamilyForName(ViewModel.SelectedFont), Mode=OneWay}"
                       FontSize="{x:Bind ViewModel.FontSize, Mode=OneWay}"
                       KeyDown="EditorTextBox_KeyDown"
                       AutomationProperties.Name="Editor" />
            </Grid>
          </ScrollViewer>

          <!-- Backspace flash overlay -->
          <Border x:Name="BackspaceFlash"
                  Background="{ThemeResource BackspaceFlashBrush}"
                  Opacity="0"
                  IsHitTestVisible="False" />

          <!-- Bottom hover sensor (96px) — reveals chrome when timer running -->
          <Grid x:Name="BottomHoverSensor"
                Height="96"
                VerticalAlignment="Bottom"
                Background="Transparent"
                PointerEntered="BottomHoverSensor_PointerEntered"
                PointerExited="BottomHoverSensor_PointerExited" />

          <!-- Chrome pill (bottom centered) -->
          <!-- REVIEW: hand-rolled StackPanel + Border separators. Next chrome edit should evaluate utu:AutoLayout + Toolkit Chip styles per Component priority Tier 1. -->
          <Border x:Name="ChromeContainer"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,24"
                  Background="{ThemeResource ChromeBackgroundBrush}"
                  BorderBrush="{ThemeResource ChromeOutlineBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="6,4,6,4"
                  Opacity="{x:Bind ViewModel.ChromeOpacity, Mode=OneWay}"
                  PointerEntered="ChromeContainer_PointerEntered"
                  PointerExited="ChromeContainer_PointerExited"
                  GotFocus="ChromeContainer_GotFocus">
            <StackPanel Orientation="Horizontal" Spacing="2">

              <!-- Font size -->
              <Button Style="{StaticResource ChromeTextButtonStyle}"
                      Command="{x:Bind ViewModel.CycleSizeCommand}"
                      Content="{x:Bind vm:Formatters.FormatFontSize(ViewModel.FontSize), Mode=OneWay}"
                      AutomationProperties.Name="Font size"
                      ToolTipService.ToolTip="Font size" />

              <Border Width="1" Height="14" Background="{ThemeResource ChromeOutlineBrush}" VerticalAlignment="Center" />

              <!-- Font name -->
              <Button Style="{StaticResource ChromeTextButtonStyle}"
                      Command="{x:Bind ViewModel.CycleFontCommand}"
                      Content="{x:Bind ViewModel.SelectedFont, Mode=OneWay}"
                      AutomationProperties.Name="Font"
                      ToolTipService.ToolTip="Font" />

              <Border Width="1" Height="14" Background="{ThemeResource ChromeOutlineBrush}" VerticalAlignment="Center" />

              <!-- Timer -->
              <Button x:Name="TimerButton"
                      Style="{StaticResource ChromeTextButtonStyle}"
                      Command="{x:Bind ViewModel.ToggleTimerCommand}"
                      Content="{x:Bind vm:Formatters.FormatTimer(ViewModel.TimeRemaining), Mode=OneWay}"
                      FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                      PointerWheelChanged="TimerButton_PointerWheelChanged"
                      DoubleTapped="TimerButton_DoubleTapped"
                      AutomationProperties.Name="Timer"
                      ToolTipService.ToolTip="Click to start. Double-click to reset." />

              <Border Width="1" Height="14" Background="{ThemeResource ChromeOutlineBrush}" VerticalAlignment="Center" />

              <!-- Backspace lock -->
              <Button x:Name="BackspaceButton"
                      Style="{StaticResource ChromeIconButtonStyle}"
                      Command="{x:Bind ViewModel.ToggleBackspaceCommand}"
                      Content="&#x232B;"
                      Foreground="{x:Bind ActiveOrInactiveBrush(ViewModel.BackspaceDisabled), Mode=OneWay}"
                      AutomationProperties.Name="Backspace lock"
                      ToolTipService.ToolTip="Toggle backspace lock" />

              <!-- Chat -->
              <Button x:Name="ChatButton"
                      Style="{StaticResource ChromeIconButtonStyle}"
                      Content="&#x1F4AC;"
                      AutomationProperties.Name="Send to AI"
                      ToolTipService.ToolTip="Send to AI">
                <Button.Flyout>
                  <MenuFlyout Placement="Top">
                    <MenuFlyoutItem Text="Claude"  Click="ChatClaude_Click" />
                    <MenuFlyoutItem Text="ChatGPT" Click="ChatChatGpt_Click" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <!-- PDF -->
              <Button Style="{StaticResource ChromeIconButtonStyle}"
                      Command="{x:Bind ViewModel.ExportPdfCommand}"
                      Content="&#x1F4C4;"
                      AutomationProperties.Name="Export PDF"
                      ToolTipService.ToolTip="Export PDF" />

              <!-- New entry -->
              <Button Style="{StaticResource ChromeIconButtonStyle}"
                      Command="{x:Bind ViewModel.NewEntryCommand}"
                      Content="&#xFF0B;"
                      AutomationProperties.Name="New entry"
                      ToolTipService.ToolTip="New entry" />

              <!-- Theme toggle -->
              <Button Style="{StaticResource ChromeIconButtonStyle}"
                      Command="{x:Bind ViewModel.ToggleThemeCommand}"
                      Content="{x:Bind vm:Formatters.ThemeGlyph(ViewModel.Theme), Mode=OneWay}"
                      AutomationProperties.Name="Theme"
                      ToolTipService.ToolTip="Toggle theme" />

              <!-- Sidebar toggle -->
              <Button Style="{StaticResource ChromeIconButtonStyle}"
                      Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                      Content="&#x2630;"
                      AutomationProperties.Name="History"
                      ToolTipService.ToolTip="History" />
            </StackPanel>
          </Border>

          <!-- Persistent error toast (save / load failure per Interaction Brief §5) -->
          <Border x:Name="PersistentToastBorder"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,140"
                  Background="{ThemeResource ChromeIconBrushActive}"
                  CornerRadius="8"
                  Padding="14,8"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
            <TextBlock x:Name="PersistentToastText"
                       Foreground="{ThemeResource EditorBackgroundBrush}"
                       FontFamily="{StaticResource LatoFontFamily}"
                       FontSize="13" />
          </Border>

          <!-- Toast -->
          <Border x:Name="ToastBorder"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,96"
                  Background="{ThemeResource ChromeIconBrushActive}"
                  CornerRadius="8"
                  Padding="14,8"
                  Opacity="0"
                  IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       Foreground="{ThemeResource EditorBackgroundBrush}"
                       FontFamily="{StaticResource LatoFontFamily}"
                       FontSize="13" />
          </Border>

          <!-- Theme cross-fade overlay (painted with the OUTGOING surface color,
               then faded out). Kept LAST so it sits above chrome + toasts during
               the fade; otherwise the chrome's theme brushes flip color instantly
               and the user sees a flash. -->
          <Border x:Name="ThemeFadeOverlay"
                  Opacity="0"
                  IsHitTestVisible="False" />
        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</Page>
