<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Editor font families. When the .ttf assets in Assets/Fonts/ are present,
    replace each entry with the URI form, e.g.
      <FontFamily x:Key="LatoFontFamily">ms-appx:///Assets/Fonts/Lato-Regular.ttf#Lato</FontFamily>
    See Assets/Fonts/README.md.
  -->
  <FontFamily x:Key="LatoFontFamily">Lato</FontFamily>
  <FontFamily x:Key="NewsreaderFontFamily">Newsreader</FontFamily>
  <FontFamily x:Key="JetBrainsMonoFontFamily">JetBrains Mono</FontFamily>

</ResourceDictionary>
