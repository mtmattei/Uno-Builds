<!--
    SettingsPage.xaml — "Orbital" settings screen (arm C: brief + free-prose notes).
    Desktop-first, dark theme. Tokens and shared styles live in Tokens.xaml.
-->
<Page
    x:Class="AbExperiment.C.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header ==================== -->
        <Grid
            Grid.Row="0"
            Padding="{StaticResource HeaderPadding}"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    Text="Settings"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="{StaticResource FontSizeTitle}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextHighBrush}" />
                <TextBlock
                    Text="Profile and preferences"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{StaticResource TextFaintBrush}" />
            </StackPanel>

            <!-- Search pill. Opens a search/command UI that is still TBD — rendered, not wired. -->
            <Border
                x:Name="SearchPill"
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextFaintBrush}" />
                    <TextBlock
                        Text="Search or run command..."
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="{StaticResource FontSizeMonoBody}"
                        Foreground="{StaticResource TextFaintBrush}"
                        VerticalAlignment="Center" />
                    <Border
                        Background="{StaticResource InsetBackgroundBrush}"
                        CornerRadius="{StaticResource BadgeCornerRadius}"
                        Padding="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Ctrl+K"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="{StaticResource FontSizeMonoTiny}"
                            Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Content ==================== -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="24">

                <!-- Card 1 — PROFILE (full width) -->
                <!-- Cards start hidden/offset; the staggered entrance storyboard
                     (built in code-behind) animates them in on load. -->
                <Border x:Name="ProfileSection" Style="{StaticResource SectionCardStyle}" Opacity="0">
                    <Border.RenderTransform>
                        <CompositeTransform TranslateY="16" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock
                            Text="PROFILE"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Margin="0,0,0,16" />
                        <TextBlock
                            Text="Display Name"
                            Style="{StaticResource FieldLabelTextStyle}"
                            Margin="0,0,0,8" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="UsernameBox"
                                Grid.Column="0"
                                PlaceholderText="Enter your name"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="13" />
                            <Button
                                x:Name="SaveUsernameButton"
                                Grid.Column="1"
                                Content="Save"
                                Style="{StaticResource AccentFilledButtonStyle}"
                                VerticalAlignment="Stretch"
                                Click="SaveUsernameButton_Click" />
                        </Grid>
                        <TextBlock
                            Text="This name appears in the homepage greeting."
                            Style="{StaticResource HelperTextStyle}"
                            Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Two-column row (16 gutter) -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 2 — ABOUT -->
                    <Border
                        x:Name="AboutSection"
                        Grid.Column="0"
                        Style="{StaticResource SectionCardStyle}"
                        VerticalAlignment="Top"
                        Opacity="0">
                        <Border.RenderTransform>
                            <CompositeTransform TranslateY="16" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock
                                Text="ABOUT"
                                Style="{StaticResource SectionHeaderTextStyle}"
                                Margin="0,0,0,16" />

                            <!-- Identity row -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Background="{StaticResource InsetBackgroundBrush}"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                    <!-- 32×32 product logo stand-in: stylized orbit mark. -->
                                    <Grid Width="32" Height="32">
                                        <Ellipse
                                            Width="26"
                                            Height="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stroke="{StaticResource AccentBrush}"
                                            StrokeThickness="2" />
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,1,1,0"
                                            Fill="{StaticResource TextHighBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock
                                        Text="Orbital"
                                        FontFamily="{StaticResource DisplayFontFamily}"
                                        FontSize="{StaticResource FontSizeBody}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextHighBrush}" />
                                    <!-- Binds to VersionDisplay in the app; fallback shown here. -->
                                    <TextBlock
                                        x:Name="VersionText"
                                        Text="v0.1.0-alpha"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="{StaticResource FontSizeMonoCaption}"
                                        Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Environment rows (label left / value right).
                                 Values bind to EnvStatus.UnoSdkVersion / DotNetDisplay /
                                 EnvStatus.Renderer / PlatformInfo in the app. -->
                            <StackPanel Margin="0,16,0,0" Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Uno Platform SDK" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock x:Name="UnoSdkValue" Grid.Column="1" Text="..." Style="{StaticResource MonoValueTextStyle}" TextAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text=".NET Runtime" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock x:Name="DotNetValue" Grid.Column="1" Text="..." Style="{StaticResource MonoValueTextStyle}" TextAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Renderer" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock x:Name="RendererValue" Grid.Column="1" Text="..." Style="{StaticResource MonoValueTextStyle}" TextAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Platform" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock x:Name="PlatformValue" Grid.Column="1" Text="..." Style="{StaticResource MonoValueTextStyle}" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right column: PATHS, then ACTIONS -->
                    <StackPanel Grid.Column="1" Spacing="24">

                        <!-- Card 3 — PATHS (label over wrapping value).
                             Values bind to ProjectRoot / RecentsPath / SkillsPath in the app. -->
                        <Border x:Name="PathsSection" Style="{StaticResource SectionCardStyle}" Opacity="0">
                            <Border.RenderTransform>
                                <CompositeTransform TranslateY="16" />
                            </Border.RenderTransform>
                            <StackPanel>
                                <TextBlock
                                    Text="PATHS"
                                    Style="{StaticResource SectionHeaderTextStyle}"
                                    Margin="0,0,0,16" />
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Project Root" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock x:Name="ProjectRootValue" Text="..." Style="{StaticResource MonoValueTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Recent Projects Database" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock x:Name="RecentsPathValue" Text="..." Style="{StaticResource MonoValueTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Claude Code Skills" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock x:Name="SkillsPathValue" Text="..." Style="{StaticResource MonoValueTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4 — ACTIONS -->
                        <Border x:Name="ActionsSection" Style="{StaticResource SectionCardStyle}" Opacity="0">
                            <Border.RenderTransform>
                                <CompositeTransform TranslateY="16" />
                            </Border.RenderTransform>
                            <StackPanel>
                                <TextBlock
                                    Text="ACTIONS"
                                    Style="{StaticResource SectionHeaderTextStyle}"
                                    Margin="0,0,0,12" />
                                <StackPanel Spacing="12">
                                    <Button
                                        x:Name="ClearRecentsButton"
                                        Style="{StaticResource QuietActionButtonStyle}"
                                        Click="ClearRecentsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                Glyph="&#xE74D;"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="Clear Recent Projects" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="OpenDataFolderButton"
                                        Style="{StaticResource QuietActionButtonStyle}"
                                        Click="OpenDataFolderButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                Glyph="&#xE838;"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="Open Data Folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="OpenDocsButton"
                                        Style="{StaticResource QuietActionButtonStyle}"
                                        Click="OpenDocsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                Glyph="&#xE736;"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="Uno Platform Documentation" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
