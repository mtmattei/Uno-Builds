<!--
  Tokens.xaml — Orbital design tokens + shared styles for the Settings screen.
  Keys mirror the Design Graph's `properties.uno` mapping layer (run4.graph.json)
  so the implementation stays traceable to the original design system:
    - Color tokens  -> Orbital*Brush SolidColorBrush resources
    - Typography    -> OrbitalPageTitle / OrbitalBody / OrbitalSectionHeader /
                       OrbitalMonoSmall TextBlock styles + OrbitalMonoFont FontFamily
    - Surfaces      -> OrbitalCardStyle (Border)
    - Buttons       -> OrbitalPrimaryButtonSm / OrbitalGhostButtonSm
  Font note: the original faces are Space Grotesk (sans) and JetBrains Mono.
  Per experiment rules, system fallbacks are used: Segoe UI and Consolas.
  Interaction variants (hover/pressed brushes) are folded per the graph's
  variant-folding note, so button templates are intentionally state-less.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Color tokens (token.color.*) ============ -->
    <SolidColorBrush x:Key="OrbitalSurface0Brush" Color="#FF0A0A0B" />
    <SolidColorBrush x:Key="OrbitalSurface1Brush" Color="#FF141416" />
    <SolidColorBrush x:Key="OrbitalSurface2Brush" Color="#FF1A1A1C" />
    <SolidColorBrush x:Key="OrbitalSurface3Brush" Color="#FF212123" />
    <SolidColorBrush x:Key="OrbitalEmerald500Brush" Color="#FF10B981" />
    <SolidColorBrush x:Key="OrbitalText90Brush" Color="#FFE3E5EC" />
    <SolidColorBrush x:Key="OrbitalText85Brush" Color="#FFD6D9E1" />
    <SolidColorBrush x:Key="OrbitalText72Brush" Color="#FFB5B9C5" />
    <SolidColorBrush x:Key="OrbitalText55Brush" Color="#FF8A90A0" />
    <SolidColorBrush x:Key="OrbitalText50Brush" Color="#FF7B8191" />
    <SolidColorBrush x:Key="OrbitalText40Brush" Color="#FF626878" />
    <SolidColorBrush x:Key="OrbitalText38Brush" Color="#FF5D6372" />
    <SolidColorBrush x:Key="OrbitalText35Brush" Color="#FF565C6B" />
    <SolidColorBrush x:Key="OrbitalText30Brush" Color="#FF4A505D" />

    <!-- ============ Font families (token.typography.mono-font + sans) ============ -->
    <!-- Original: JetBrains Mono -->
    <FontFamily x:Key="OrbitalMonoFont">Consolas</FontFamily>
    <!-- Original: Space Grotesk -->
    <FontFamily x:Key="OrbitalSansFont">Segoe UI</FontFamily>

    <!-- ============ Typography styles (token.typography.*) ============ -->

    <!-- token.typography.page-title: sans 20 SemiBold, tracking -25 -->
    <Style x:Key="OrbitalPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OrbitalSansFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{StaticResource OrbitalText90Brush}" />
    </Style>

    <!-- token.typography.body: sans 13 Medium -->
    <Style x:Key="OrbitalBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OrbitalSansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource OrbitalText85Brush}" />
    </Style>

    <!-- token.typography.section-header: mono 11 Medium, tracking 80, uppercase by content -->
    <Style x:Key="OrbitalSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OrbitalMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource OrbitalText38Brush}" />
    </Style>

    <!-- token.typography.mono-small: mono 11 Normal -->
    <Style x:Key="OrbitalMonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OrbitalMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OrbitalText50Brush}" />
    </Style>

    <!-- ============ Surfaces (component.card canonical surface) ============ -->
    <!-- OrbitalCardStyle: Surface1 bg, 1px Surface3 border, radius 12, padding 20 -->
    <Style x:Key="OrbitalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OrbitalSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OrbitalSurface3Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- ============ Buttons ============ -->
    <!--
      State-less templates: PointerOver/Pressed/Disabled visuals were folded
      into the base tokens by the graph, so no VisualStateManager states are
      re-invented here.
    -->
    <ControlTemplate x:Key="OrbitalFlatButtonTemplate" TargetType="Button">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
    </ControlTemplate>

    <!-- control.profile.save: emerald bg, dark (Surface0) text, radius 8, padding 12x6 -->
    <Style x:Key="OrbitalPrimaryButtonSm" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OrbitalEmerald500Brush}" />
        <Setter Property="Foreground" Value="{StaticResource OrbitalSurface0Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{StaticResource OrbitalSansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource OrbitalFlatButtonTemplate}" />
    </Style>

    <!-- component.action-button: transparent quiet button, Text55 resting fg, radius 8, padding 12x6 -->
    <Style x:Key="OrbitalGhostButtonSm" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OrbitalText55Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{StaticResource OrbitalSansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource OrbitalFlatButtonTemplate}" />
    </Style>

</ResourceDictionary>
