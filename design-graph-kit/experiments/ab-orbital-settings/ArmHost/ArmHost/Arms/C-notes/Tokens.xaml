<!--
    Tokens.xaml — design tokens and shared styles for the Orbital Settings screen.
    Merged locally by SettingsPage.xaml via Page.Resources MergedDictionaries.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Palette ==================== -->

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#141416" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#212123" />
    <!-- Hairline separators and inset surfaces (logo tile, keycap badge, quiet-button hover). -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#1A1A1C" />
    <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#1A1A1C" />

    <!-- Text emphasis ramp -->
    <SolidColorBrush x:Key="TextHighBrush" Color="#D6D9E1" />
    <SolidColorBrush x:Key="TextMediumBrush" Color="#B5B9C5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7B8191" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#5D6372" />

    <!-- Accent (emerald, used sparingly; dark text on it) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#34D399" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0DA271" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0A0A0B" />

    <!-- Quiet button interaction surfaces -->
    <SolidColorBrush x:Key="QuietHoverBrush" Color="#1A1A1C" />
    <SolidColorBrush x:Key="QuietPressedBrush" Color="#212123" />

    <!-- ==================== Typography ==================== -->

    <!-- Stand-ins: a default geometric-ish sans for display/body, Consolas for mono. -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <x:Double x:Key="FontSizeTitle">28</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeMonoCaption">11</x:Double>
    <x:Double x:Key="FontSizeMonoBody">12</x:Double>
    <x:Double x:Key="FontSizeMonoTiny">10</x:Double>

    <!-- ==================== Shape & spacing ==================== -->

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">4</CornerRadius>

    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="PagePadding">32</Thickness>
    <Thickness x:Key="HeaderPadding">32,20</Thickness>
    <Thickness x:Key="CompactButtonPadding">12,6</Thickness>

    <!-- ==================== TextBox lightweight styling overrides ==================== -->
    <!-- Consumed by the default WinUI TextBox template via ThemeResource lookup. -->

    <SolidColorBrush x:Key="TextControlBackground" Color="#141416" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#141416" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#141416" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#141416" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#212123" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2A2A2D" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#10B981" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#D6D9E1" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#D6D9E1" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#D6D9E1" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5D6372" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#5D6372" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5D6372" />

    <!-- ==================== Card ==================== -->

    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- ==================== Text styles ==================== -->

    <!-- Section header: PROFILE / ABOUT / PATHS / ACTIONS -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMonoCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="CharacterSpacing" Value="100" />
    </Style>

    <!-- Field / row label (left side, muted) -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMonoCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- Value text (medium emphasis) -->
    <Style x:Key="MonoValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMonoCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextMediumBrush}" />
    </Style>

    <!-- Helper / hint text (faint) -->
    <Style x:Key="HelperTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMonoCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== Buttons ==================== -->

    <!-- Compact filled accent button (Save) -->
    <Style x:Key="AccentFilledButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource CompactButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource AccentHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource AccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-width, left-aligned quiet button (ACTIONS card) -->
    <Style x:Key="QuietActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMediumBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource CompactButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource QuietHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource QuietPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
