<!--
  SettingsPage.xaml — "Orbital" Settings screen (Design Graph arm B2).
  Semantic source of truth: evals/05-orbital-settings/blind-v4/run4.graph.json
  Visual reference: experiments/ab-orbital-settings/brief.md

  Graph traceability notes:
  - screen.settings          -> this Page (graph class Orbital.Presentation.SettingsPage;
                                remapped to AbExperiment.B2.SettingsPage for this experiment).
  - component.page-header    -> in the source app this is the reusable UserControl
                                Orbital.Controls.PageHeader; the experiment writes a single
                                page, so the component is inlined below inside a clearly
                                marked boundary (x:Name="Header" per the graph instance),
                                preserving its internal part names (TitleText, SubtitleText,
                                SearchBorder).
  - component.card           -> Border + OrbitalCardStyle; instances ProfileSection,
                                AboutSection, PathsSection, ActionsSection.
  - Bindings use the graph-declared paths with '...' fallbacks. The DataContext/ViewModel
    identity is unresolved in the graph (unresolved.viewmodel-identity), so no DataContext
    is invented; with none set the fallbacks render, which matches the mock's populated
    "still loading" values.
  - Page padding: the graph notes responsive padding (Narrow=16 via utu:Responsive); the
    experiment forbids toolkit namespaces, so the Normal/Wide value 32 is used statically.
-->
<Page
    x:Class="AbExperiment.B2.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource OrbitalSurface0Brush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- screen.settings layout: header row (Auto) over scrollable content row (*) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================
             component.page-header.settings (instance-of component.page-header)
             Inlined PageHeader: title + subtitle left, search pill right.
             ================================================================ -->
        <Border
            x:Name="Header"
            Grid.Row="0"
            BorderBrush="{StaticResource OrbitalSurface2Brush}"
            BorderThickness="0,0,0,1"
            Padding="32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- title / subtitle, 4px apart -->
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource OrbitalPageTitle}"
                        Text="Settings" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Style="{StaticResource OrbitalBody}"
                        FontWeight="Normal"
                        Foreground="{StaticResource OrbitalText40Brush}"
                        Text="Profile and preferences" />
                </StackPanel>

                <!-- search pill; Tapped raises the static SearchRequested event
                     (subscriber unresolved in graph: unresolved.search-requested-target) -->
                <Border
                    x:Name="SearchBorder"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="{StaticResource OrbitalSurface1Brush}"
                    BorderBrush="{StaticResource OrbitalSurface3Brush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Tapped="SearchBorder_Tapped"
                    AutomationProperties.Name="Search or run command">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            Glyph="&#xE721;"
                            FontSize="14"
                            Foreground="{StaticResource OrbitalText35Brush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontFamily="{StaticResource OrbitalMonoFont}"
                            FontSize="12"
                            Foreground="{StaticResource OrbitalText30Brush}"
                            VerticalAlignment="Center"
                            Text="Search or run command..." />
                        <!-- Ctrl+K keycap chip -->
                        <Border
                            Background="{StaticResource OrbitalSurface2Brush}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="{StaticResource OrbitalMonoFont}"
                                FontSize="10"
                                Foreground="{StaticResource OrbitalText35Brush}"
                                Text="Ctrl+K" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================
             region.settings.content — scrollable; padding 32; stack spacing 24;
             two equal columns (16 gutter) below the full-width profile card.
             ================================================================ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="24">

                <!-- ========================================================
                     component.card.profile (instance-of component.card)
                     Entrance: Opacity 0 / TranslateY 8 until FadeUp (delay 0ms)
                     ======================================================== -->
                <Border
                    x:Name="ProfileSection"
                    Style="{StaticResource OrbitalCardStyle}"
                    Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="8" />
                    </Border.RenderTransform>
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource OrbitalSectionHeader}" Text="PROFILE" />

                        <StackPanel Spacing="8">
                            <!-- content.profile.display-name-label -->
                            <TextBlock
                                Style="{StaticResource OrbitalMonoSmall}"
                                Foreground="{StaticResource OrbitalText50Brush}"
                                Text="Display Name" />

                            <!-- input + Save button, 8 apart -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- control.profile.username-box -->
                                <TextBox
                                    x:Name="UsernameBox"
                                    Grid.Column="0"
                                    FontFamily="{StaticResource OrbitalMonoFont}"
                                    FontSize="13"
                                    Background="{StaticResource OrbitalSurface1Brush}"
                                    BorderBrush="{StaticResource OrbitalSurface3Brush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Foreground="{StaticResource OrbitalText85Brush}"
                                    PlaceholderForeground="{StaticResource OrbitalText38Brush}"
                                    PlaceholderText="Enter your name"
                                    VerticalAlignment="Center">
                                    <TextBox.Resources>
                                        <!-- Keep the dark treatment across the default
                                             template's PointerOver/Focused states. -->
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF141416" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF141416" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF212123" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF10B981" />
                                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFD6D9E1" />
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFD6D9E1" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF5D6372" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF5D6372" />
                                    </TextBox.Resources>
                                </TextBox>

                                <!-- control.profile.save
                                     has-state / triggers state.profile.saved:
                                     content flips to 'Saved!' for 1500ms in code-behind. -->
                                <Button
                                    x:Name="SaveUsernameButton"
                                    Grid.Column="1"
                                    Style="{StaticResource OrbitalPrimaryButtonSm}"
                                    Content="Save"
                                    Click="SaveUsernameButton_Click"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- content.profile.helper-text -->
                            <TextBlock
                                Style="{StaticResource OrbitalMonoSmall}"
                                Foreground="{StaticResource OrbitalText30Brush}"
                                Text="This name appears in the homepage greeting." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Two-column row: left About, right Paths + Actions; 16 gutter -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ================================================
                         component.card.about (instance-of component.card)
                         Entrance delay 100ms
                         ================================================ -->
                    <StackPanel Grid.Column="0" Spacing="24">
                        <Border
                            x:Name="AboutSection"
                            Style="{StaticResource OrbitalCardStyle}"
                            VerticalAlignment="Top"
                            Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="8" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource OrbitalSectionHeader}" Text="ABOUT" />

                                <!-- identity block: 48x48 badge + name/version -->
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <!-- asset.about.logo -->
                                    <Border
                                        Width="48"
                                        Height="48"
                                        Background="{StaticResource OrbitalSurface2Brush}"
                                        CornerRadius="12">
                                        <Image
                                            Width="32"
                                            Height="32"
                                            Source="ms-appx:///Assets/Icons/Uno-logo.png"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <!-- content.about.app-name -->
                                        <TextBlock
                                            Style="{StaticResource OrbitalBody}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource OrbitalText85Brush}"
                                            Text="Orbital" />
                                        <!-- content.about.version -->
                                        <TextBlock
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText40Brush}"
                                            Text="{Binding VersionDisplay, FallbackValue='v0.1.0-alpha'}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- component.info-row instances, 8 apart -->
                                <StackPanel Spacing="8">
                                    <!-- component.info-row.uno-sdk -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText50Brush}"
                                            Text="Uno Platform SDK" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText72Brush}"
                                            TextAlignment="Right"
                                            Text="{Binding EnvStatus.UnoSdkVersion, FallbackValue='...'}" />
                                    </Grid>
                                    <!-- component.info-row.dotnet-runtime -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText50Brush}"
                                            Text=".NET Runtime" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText72Brush}"
                                            TextAlignment="Right"
                                            Text="{Binding DotNetDisplay, FallbackValue='...'}" />
                                    </Grid>
                                    <!-- component.info-row.renderer -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText50Brush}"
                                            Text="Renderer" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText72Brush}"
                                            TextAlignment="Right"
                                            Text="{Binding EnvStatus.Renderer, FallbackValue='...'}" />
                                    </Grid>
                                    <!-- component.info-row.platform -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText50Brush}"
                                            Text="Platform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource OrbitalMonoSmall}"
                                            Foreground="{StaticResource OrbitalText72Brush}"
                                            TextAlignment="Right"
                                            Text="{Binding PlatformInfo, FallbackValue='...'}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right column: Paths, then 24 below it Actions -->
                    <StackPanel Grid.Column="1" Spacing="24">

                        <!-- ============================================
                             component.card.paths (instance-of component.card)
                             Entrance delay 200ms
                             ============================================ -->
                        <Border
                            x:Name="PathsSection"
                            Style="{StaticResource OrbitalCardStyle}"
                            Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="8" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource OrbitalSectionHeader}" Text="PATHS" />

                                <!-- component.path-field.project-root -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource OrbitalMonoSmall}"
                                        Foreground="{StaticResource OrbitalText50Brush}"
                                        Text="Project Root" />
                                    <TextBlock
                                        Style="{StaticResource OrbitalMonoSmall}"
                                        Foreground="{StaticResource OrbitalText72Brush}"
                                        TextWrapping="Wrap"
                                        Text="{Binding ProjectRoot, FallbackValue='...'}" />
                                </StackPanel>

                                <!-- component.path-field.recents-database -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource OrbitalMonoSmall}"
                                        Foreground="{StaticResource OrbitalText50Brush}"
                                        Text="Recent Projects Database" />
                                    <TextBlock
                                        Style="{StaticResource OrbitalMonoSmall}"
                                        Foreground="{StaticResource OrbitalText72Brush}"
                                        TextWrapping="Wrap"
                                        Text="{Binding RecentsPath, FallbackValue='...'}" />
                                </StackPanel>

                                <!-- component.path-field.skills -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource OrbitalMonoSmall}"
                                        Foreground="{StaticResource OrbitalText50Brush}"
                                        Text="Claude Code Skills" />
                                    <TextBlock
                                        Style="{StaticResource OrbitalMonoSmall}"
                                        Foreground="{StaticResource OrbitalText72Brush}"
                                        TextWrapping="Wrap"
                                        Text="{Binding SkillsPath, FallbackValue='...'}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============================================
                             component.card.actions (instance-of component.card)
                             Internal spacing 12 (overrides canonical 16).
                             Entrance delay 300ms
                             ============================================ -->
                        <Border
                            x:Name="ActionsSection"
                            Style="{StaticResource OrbitalCardStyle}"
                            Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="8" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource OrbitalSectionHeader}" Text="ACTIONS" />

                                <!-- component.action-button.clear-recents
                                     triggers control.actions.cleared-dialog -->
                                <Button
                                    x:Name="ClearRecentsButton"
                                    Style="{StaticResource OrbitalGhostButtonSm}"
                                    Click="ClearRecentsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            Glyph="&#xE74D;"
                                            FontSize="14" />
                                        <TextBlock Text="Clear Recent Projects" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- component.action-button.open-data-folder -->
                                <Button
                                    x:Name="OpenDataFolderButton"
                                    Style="{StaticResource OrbitalGhostButtonSm}"
                                    Click="OpenDataFolderButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            Glyph="&#xE838;"
                                            FontSize="14" />
                                        <TextBlock Text="Open Data Folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- component.action-button.open-docs -->
                                <Button
                                    x:Name="OpenDocsButton"
                                    Style="{StaticResource OrbitalGhostButtonSm}"
                                    Click="OpenDocsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            Glyph="&#xE8A5;"
                                            FontSize="14" />
                                        <TextBlock Text="Uno Platform Documentation" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
