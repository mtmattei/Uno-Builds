<Application x:Class="YouTubeMs.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:anim="using:Microsoft.UI.Xaml.Media.Animation"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/AppResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Easing curves: QuarticEase ≈ cubic-bezier(0.23,1,0.32,1) — Emil's strong ease-out -->
      <QuarticEase x:Key="StandardEaseOut" EasingMode="EaseOut" />
      <BackEase x:Key="SpringEase" EasingMode="EaseOut" Amplitude="0.3" />
      <QuadraticEase x:Key="DecelerateEase" EasingMode="EaseOut" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
