<UserControl x:Class="YouTubeMs.Presentation.Controls.RailItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             MinHeight="96">

    <Button x:Name="RailButton"
            Style="{StaticResource FlatItemButtonStyle}"
            Background="#142E3A"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5"
            UseSystemFocusVisuals="True"
            AutomationProperties.Name="{x:Bind Item.Title, Mode=OneWay, FallbackValue=''}">
        <Button.RenderTransform>
            <CompositeTransform x:Name="RailTransform" ScaleX="1" ScaleY="1" TranslateY="0" />
        </Button.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RailTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RailTransform" Storyboard.TargetProperty="TranslateY" To="-3" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailTransform" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailTransform" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailThumbScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RailThumbScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="RailTransform.TranslateY" Value="-1" />
                        <Setter Target="RailTransform.ScaleX" Value="0.97" />
                        <Setter Target="RailTransform.ScaleY" Value="0.97" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thumbnail (full container, edge-to-edge) -->
            <Border x:Name="Thumb"
                    Grid.Column="0"
                    CornerRadius="6,0,0,6"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Image x:Name="RailThumbImage"
                           Source="{x:Bind Item.ThumbnailUrl, Mode=OneWay, FallbackValue=''}"
                           Stretch="UniformToFill"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="RailThumbScale" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,4,4"
                            CornerRadius="4"
                            Padding="4,1"
                            Background="#B3000000">
                        <TextBlock Text="{x:Bind Item.DurationLabel, Mode=OneWay, FallbackValue='0:00'}"
                                   FontSize="10"
                                   Foreground="#FFFFFF" />
                    </Border>
                </Grid>
            </Border>

            <!-- Text column -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Spacing="2">
                <TextBlock Text="{x:Bind Item.Title, Mode=OneWay, FallbackValue=''}"
                           Style="{StaticResource BodyMediumTextBlockStyle}"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Item.Channel.Name, Mode=OneWay, FallbackValue=''}"
                           Style="{StaticResource MetadataTextStyle}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
