<UserControl x:Class="YouTubeMs.Presentation.Controls.HeroFeatured"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             x:Name="Self">
    <Border x:Name="HeroRootBorder"
            CornerRadius="20"
            BorderBrush="#882EE0E0"
            BorderThickness="1.5"
            Height="420"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <CompositeTransform x:Name="HeroEntranceTransform" ScaleX="0.96" ScaleY="0.96" />
        </Border.RenderTransform>
        <Grid x:Name="HeroRoot">
            <!-- Layer 1: channel-tinted gradient (fallback) -->
            <Border x:Name="HeroFill">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B5E6B" Offset="0.0" />
                        <GradientStop Color="#2D8A8A" Offset="0.5" />
                        <GradientStop Color="#4A9CA3" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Layer 2: real hero image -->
            <Image Source="{x:Bind Featured.BackgroundImageUrl, Mode=OneWay, FallbackValue=''}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

            <!-- Left-anchored darkening overlay so text remains legible -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#33000000" Offset="0.7" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <utu:AutoLayout Orientation="Vertical"
                            Spacing="16"
                            Padding="40,32"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            MaxWidth="640">

                <!-- Microsoft Featured chip -->
                <Border CornerRadius="16"
                        Padding="10,5"
                        Background="#33FFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        utu:AutoLayout.CounterAlignment="Start">
                    <utu:AutoLayout Orientation="Horizontal" Spacing="8">
                        <Grid Width="14" Height="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#F25022" Margin="0,0,1,1" />
                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1" />
                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0,1,1,0" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0" />
                        </Grid>
                        <TextBlock Text="{x:Bind Featured.BadgeText, Mode=OneWay, FallbackValue='Microsoft Featured'}"
                                   Style="{StaticResource LabelLargeTextBlockStyle}"
                                   Foreground="#F4F8FA"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </utu:AutoLayout>
                </Border>

                <TextBlock Text="{x:Bind Featured.Title, Mode=OneWay, FallbackValue='Discover Nature&#x27;s Wonders in 4K'}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxLines="3"
                           LineHeight="42" />

                <TextBlock Text="{x:Bind Featured.Description, Mode=OneWay, FallbackValue='Experience the serene beauty of Yosemite Valley in stunning 4K resolution. Filmed with the new Surface Pro 10.'}"
                           FontSize="14"
                           Foreground="#D9F3F8"
                           TextWrapping="Wrap"
                           MaxLines="3" />

                <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,8,0,0">
                    <Button x:Name="PlayCta"
                            Background="#2EE0E0"
                            Foreground="#03252A"
                            BorderThickness="0"
                            MinHeight="44"
                            CornerRadius="22"
                            Padding="20,10"
                            RenderTransformOrigin="0.5,0.5"
                            AutomationProperties.Name="Play featured video">
                        <Button.RenderTransform>
                            <CompositeTransform x:Name="PlayCtaTransform" />
                        </Button.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlayCtaTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayCtaTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayCtaTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlayCtaTransform" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayCtaTransform" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayCtaTransform" Storyboard.TargetProperty="TranslateY" To="-1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PlayCtaTransform.ScaleX" Value="0.97" />
                                        <Setter Target="PlayCtaTransform.ScaleY" Value="0.97" />
                                        <Setter Target="PlayCtaTransform.TranslateY" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="#FFFFFF">
                                <FontIcon Glyph="&#xE768;"
                                          FontSize="12"
                                          Foreground="#2EE0E0" />
                            </Border>
                            <TextBlock Text="Play video"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#03252A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind Featured.DurationLabel, Mode=OneWay, FallbackValue='9:13'}"
                               FontSize="14"
                               Foreground="#D9F3F8"
                               VerticalAlignment="Center" />
                </StackPanel>
            </utu:AutoLayout>
        </Grid>
    </Border>
</UserControl>
