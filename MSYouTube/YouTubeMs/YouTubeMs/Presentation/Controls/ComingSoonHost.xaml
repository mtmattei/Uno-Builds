<UserControl x:Class="YouTubeMs.Presentation.Controls.ComingSoonHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI">
    <Grid Background="Transparent" Padding="32">
        <utu:AutoLayout Orientation="Vertical"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="480">
            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{ThemeResource PrimaryContainerBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE713;"
                          FontSize="28"
                          Foreground="{ThemeResource OnPrimaryContainerBrush}" />
            </Border>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource HeadlineMediumTextBlockStyle}"
                       Foreground="{ThemeResource OnSurfaceBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}"
                       Style="{StaticResource BodyMediumTextBlockStyle}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </utu:AutoLayout>
    </Grid>
</UserControl>
