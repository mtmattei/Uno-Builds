<UserControl x:Class="YouTubeMs.Presentation.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <StackPanel Orientation="Vertical"
                Spacing="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32"
                MaxWidth="360">
        <FontIcon x:Name="GlyphIcon"
                  Glyph="{x:Bind Glyph, Mode=OneWay, FallbackValue='&#xE721;'}"
                  FontSize="64"
                  Opacity="0.3"
                  Foreground="#F3F8FB"
                  HorizontalAlignment="Center" />
        <TextBlock Text="{x:Bind Headline, Mode=OneWay, FallbackValue='Nothing to show yet'}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#F3F8FB"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Helper, Mode=OneWay, FallbackValue=''}"
                   FontSize="14"
                   Foreground="#8FA1AB"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button x:Name="CtaButton"
                Content="{x:Bind CtaLabel, Mode=OneWay, FallbackValue=''}"
                Visibility="{x:Bind CtaVisibility, Mode=OneWay}"
                Background="#2EE0E0"
                Foreground="#03252A"
                BorderThickness="0"
                CornerRadius="22"
                MinHeight="40"
                Padding="20,8"
                HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
