<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font families. Without TTFs embedded these fall back to platform equivalents. -->
    <FontFamily x:Key="FontSerif">Georgia, serif</FontFamily>
    <FontFamily x:Key="FontSans">Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Menlo, monospace</FontFamily>

    <!-- ============ Surfaces (neutral grayscale, saturation 0%) ============ -->
    <SolidColorBrush x:Key="Bg0Brush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Bg1Brush" Color="#232323" />
    <SolidColorBrush x:Key="Bg2Brush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Bg3Brush" Color="#333333" />
    <SolidColorBrush x:Key="Bg4Brush" Color="#3D3D3D" />

    <!-- Surface gradient endpoints (180° vertical on stationary, 90° horizontal only on the drawer panel) -->
    <SolidColorBrush x:Key="Bg1GradientTop" Color="#262626" />
    <SolidColorBrush x:Key="Bg1GradientBot" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Bg2GradientTop" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Bg2GradientBot" Color="#262626" />
    <SolidColorBrush x:Key="Bg3GradientTop" Color="#383838" />
    <SolidColorBrush x:Key="Bg3GradientBot" Color="#2E2E2E" />

    <!-- ============ Hairlines ============ -->
    <SolidColorBrush x:Key="RuleBrush"     Color="#363636" />
    <SolidColorBrush x:Key="RuleSoftBrush" Color="#2A2A2A" />

    <!-- ============ Foregrounds ============ -->
    <SolidColorBrush x:Key="Fg1Brush" Color="#EDEDED" />
    <SolidColorBrush x:Key="Fg2Brush" Color="#C2C2C2" />
    <SolidColorBrush x:Key="Fg3Brush" Color="#909090" />
    <SolidColorBrush x:Key="Fg4Brush" Color="#707070" />
    <SolidColorBrush x:Key="Fg5Brush" Color="#525252" />

    <!-- ============ Accent + state ============ -->
    <SolidColorBrush x:Key="AccentBrush"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#C8C8C8" />

    <SolidColorBrush x:Key="OkBrush"     Color="#C0C0C0" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#353535" />

    <!-- ============ Easings ============
         Uno's KeySpline rejects ControlPoint y > 1, so EaseStrike (1.4) and EaseFlip (1.18)
         from the source spec are clamped to 1.0 here. Small overshoot is sacrificed. -->
    <KeySpline x:Key="EaseMech"     ControlPoint1="0.85,0"    ControlPoint2="0.15,1" />
    <KeySpline x:Key="EaseInk"      ControlPoint1="0.65,0"    ControlPoint2="0.35,1" />
    <KeySpline x:Key="EaseStrike"   ControlPoint1="0.2,0.9"   ControlPoint2="0.2,1" />
    <KeySpline x:Key="EaseWater"    ControlPoint1="0.45,0"    ControlPoint2="0.55,1" />
    <KeySpline x:Key="EaseFlip"     ControlPoint1="0.18,0.74" ControlPoint2="0.22,1" />
    <KeySpline x:Key="EaseUnfold"   ControlPoint1="0.45,0.05" ControlPoint2="0.1,1" />
    <KeySpline x:Key="EaseMorph"    ControlPoint1="0.45,0"    ControlPoint2="0.15,1" />
    <KeySpline x:Key="EaseBackOut"  ControlPoint1="0.34,1"    ControlPoint2="0.64,1" />

    <!-- ============ Type styles ============ -->

    <Style x:Key="MastheadEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource Fg3Brush}" />
    </Style>

    <Style x:Key="MastheadMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="BreadcrumbStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="SpecNumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="SpecNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Fg1Brush}" />
    </Style>

    <Style x:Key="SpecSummaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{StaticResource Fg1Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SpecTagStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="MotionTagStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="NavTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource Fg1Brush}" />
    </Style>

    <Style x:Key="NavBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Fg3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NavBodySmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="TabLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <Style x:Key="CanvasLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="ChipFaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="-5" />
        <Setter Property="LineHeight" Value="13" />
    </Style>

    <Style x:Key="DrawerEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="DrawerListItemStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Fg2Brush}" />
    </Style>

    <Style x:Key="DrawerHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="TimerReadoutStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{StaticResource Fg1Brush}" />
    </Style>

    <Style x:Key="TimerUnitStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="RunningLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource Fg4Brush}" />
    </Style>

    <Style x:Key="LoadedHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSerif}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="-5" />
        <Setter Property="Foreground" Value="{StaticResource Fg1Brush}" />
    </Style>

    <Style x:Key="LoadedBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Fg3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LoadedMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>

    <Style x:Key="FooterStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource Fg5Brush}" />
    </Style>

</ResourceDictionary>
