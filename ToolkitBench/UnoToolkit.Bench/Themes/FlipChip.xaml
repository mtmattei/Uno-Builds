<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:UnoToolkit.Bench.Controls">

    <!--
        Coin flip via 2D ScaleX (PlaneProjection.RotationY isn't implemented in Uno).
        A single shared transform on ChipInner animates 1 → 0 → 1; the front/back faces
        swap their Opacity discretely at the midpoint (ScaleX=0, edge-on). This gives a
        clean flip with only ever ONE face visible at a time — no half-and-half overlap.
    -->
    <Style TargetType="ctrl:FlipChip">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:FlipChip">
                    <Grid x:Name="ChipRoot" Background="Transparent">
                        <Grid x:Name="ChipInner" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="ChipInnerTransform" ScaleX="1" />
                            </Grid.RenderTransform>

                            <!-- Front face -->
                            <Border x:Name="FrontFace"
                                    Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource RuleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,0">
                                <TextBlock Style="{StaticResource ChipFaceStyle}"
                                           Foreground="{StaticResource Fg2Brush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Label}" />
                            </Border>

                            <!-- Back face (revealed when checked) -->
                            <Border x:Name="BackFace"
                                    Background="{StaticResource Fg1Brush}"
                                    BorderBrush="{StaticResource Fg1Brush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,0"
                                    Opacity="0">
                                <TextBlock Style="{StaticResource ChipFaceStyle}"
                                           Foreground="{StaticResource Bg0Brush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Label}" />
                            </Border>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <!-- Edge-on at 180ms, settle at 380ms -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChipInnerTransform" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.180" Value="0">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.380" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- Discrete face swap at the edge-on moment -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontFace" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.180" Value="1" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackFace" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.180" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChipInnerTransform" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.180" Value="0">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.380" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontFace" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.180" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackFace" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.180" Value="1" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
