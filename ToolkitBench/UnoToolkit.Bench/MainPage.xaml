<Page x:Class="UnoToolkit.Bench.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoToolkit.Bench"
      xmlns:demos="using:UnoToolkit.Bench.Demos"
      Background="{StaticResource Bg0Brush}"
      UseLayoutRounding="True">

    <ScrollViewer x:Name="MainScroller"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid HorizontalAlignment="Center" MaxWidth="1440">
            <Border BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="1,0,1,0">
                <StackPanel>

                    <!-- Masthead — slim utility bar -->
                    <Border Background="{StaticResource Bg1GradientBrush}"
                            BorderBrush="{StaticResource RuleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="36,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MastheadEyebrowStyle}"
                                       Text="UNO TOOLKIT · BENCH"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource MastheadMetaStyle}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right">
                                <Run Foreground="{StaticResource Fg4Brush}" Text="v.6.4" />
                                <Run Foreground="{StaticResource Fg5Brush}" Text="·" />
                                <Run Foreground="{StaticResource Fg4Brush}" Text="2026" />
                                <Run Foreground="{StaticResource Fg5Brush}" Text="·" />
                                <Run Foreground="{StaticResource Fg1Brush}" FontWeight="Medium" Text="05 controls" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Breadcrumb strip -->
                    <Border Background="{StaticResource Bg0Brush}"
                            BorderBrush="{StaticResource RuleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="36,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource BreadcrumbStyle}"
                                       VerticalAlignment="Center">
                                <Run Foreground="{StaticResource Fg4Brush}" Text="Bench" />
                                <Run Foreground="{StaticResource Fg5Brush}" Text="/" />
                                <Run Foreground="{StaticResource Fg1Brush}" Text="Components" />
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource BreadcrumbStyle}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right">
                                <Run Foreground="{StaticResource Fg4Brush}" Text="SKIA" />
                                <Run Foreground="{StaticResource Fg5Brush}" Text="·" />
                                <Run Foreground="{StaticResource Fg4Brush}" Text="WASM" />
                                <Run Foreground="{StaticResource Fg5Brush}" Text="·" />
                                <Run Foreground="{StaticResource Fg4Brush}" Text="DESKTOP" />
                                <Run Foreground="{StaticResource Fg5Brush}" Text="·" />
                                <Run Foreground="{StaticResource Fg1Brush}" FontWeight="Medium" Text="05 / 05" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 3 demo rows: NavBar full-width, then two pairs side-by-side -->
                    <demos:NavigationBarDemo x:Name="NavBar" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <demos:TabBarDemo    x:Name="TabBar"    Grid.Column="0" />
                        <Border Grid.Column="1" Width="1" Background="{StaticResource RuleBrush}" />
                        <demos:ChipGroupDemo x:Name="ChipGroup" Grid.Column="2" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <demos:DrawerControlDemo x:Name="Drawer"  Grid.Column="0" />
                        <Border Grid.Column="1" Width="1" Background="{StaticResource RuleBrush}" />
                        <demos:LoadingViewDemo   x:Name="Loading" Grid.Column="2" />
                    </Grid>

                    <!-- Footer -->
                    <Border Background="{StaticResource Bg1GradientBrush}"
                            BorderBrush="{StaticResource RuleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="36,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FooterStyle}" VerticalAlignment="Center">
                                <Run FontWeight="Medium" Foreground="{StaticResource Fg3Brush}" Text="uno.toolkit.ui" />
                                <Run Text=" · " />
                                <Run Text="platform.uno" />
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource FooterStyle}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="Build with restraint." />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
